<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <RootNamespace>Engine</RootNamespace>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepuPhysics" Version="2.4.0" />
    <PackageReference Include="FmodForFoxes" Version="3.2.0" />
    <PackageReference Include="FmodForFoxes.Desktop" Version="3.2.0" />
    <PackageReference Include="LibVLCSharp" Version="3.8.5" />
    <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.4.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.18" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Components" />
    <ProjectReference Include="..\Vista\Vista.csproj" />
  </ItemGroup>

  <Import Project="thirdparty\steam\Steamworks.props" />

  <!-- Steamworks.NET and the matching Windows x64 Steam API live in thirdparty/steam. -->
  <ItemGroup>
    <None Update="thirdparty\steam\steam_api64.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>steam_api64.dll</Link>
    </None>
    <None Update="thirdparty\steam\steam_appid.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <Link>steam_appid.txt</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <MonoGameContentReference Include="Content\Content.mgcb" />
    <!-- C# scripts compile normally and also remain editable assets in runtime Content. -->
    <None Include="Content\Scripts\**\*.cs" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Loose files read at runtime (NOT via the MGCB pipeline): Vista UI documents (the debug overlay
       and GameUI layers) and scenes, which the standalone game opens through the scene list
       (Content/System/SceneList.json, below). Dev runs read the source copies directly. -->
  <ItemGroup>
    <None Update="Content\UI\**\*.xml;Content\UI\**\*.css">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Content\Scenes\**\*.obsc;Content\Scenes\**\*.probes">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- FMOD audio: native libraries (supplied locally by the dev from fmod.com,
       placed under thirdparty/fmod/) and loose audio files loaded directly by
       FMOD (NOT via the MGCB pipeline). The Link flattens the DLLs to the output
       root so they sit next to the executable where FMOD can find them. -->
  <ItemGroup>
    <None Update="thirdparty\fmod\fmod.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>fmod.dll</Link>
    </None>
    <None Update="thirdparty\fmod\fmodL.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>fmodL.dll</Link>
    </None>
    <None Update="Content\Audio\**\*.*;Content\**\*.wav;Content\**\*.mp3;Content\**\*.ogg;Content\**\*.flac">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Standalone game settings (Anvil > Game Settings): GameInfo.json + the icon converted by the
       editor (both under the hidden System folder). Loose files read directly (NOT via the MGCB pipeline). When a custom icon exists
       it also becomes the executable's icon on the next build. -->
  <ItemGroup>
    <None Update="Content\System\GameInfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\System\SteamSettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Content\System\GameIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\System\SceneList.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
  <PropertyGroup Condition="Exists('Content\System\GameIcon.ico')">
    <ApplicationIcon>Content\System\GameIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Intro video: a loose file loaded directly (NOT via the MGCB pipeline).
       VideoIntroLogic reads it from <output>/Content/intro.mp4, so the Link
       flattens it out of the Content\Video source folder. -->
  <ItemGroup>
    <None Update="Content\Environment\Skyboxes\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Content\Video\intro.mp4">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Content\intro.mp4</Link>
    </None>
  </ItemGroup>

</Project>
