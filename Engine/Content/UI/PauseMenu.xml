<!--
  Pause menu (Vista). Opened by Engine/Content/Scripts/PauseMenuScript.cs when the game pauses and closed
  when it resumes. The script runs on a persistent gameobject, so the session card's numbers carry across
  scene loads. It toggles #root.open, the .active screens, .selected rows, #confirm.open and #fade, and fills
  the texts and setting rows. Designed on a 1080-high canvas. Every element needs an explicit closing tag.
-->
<div id="root">

    <!-- The frozen scene, dimmed and cooled -->
    <div id="backdrop"></div>
    <div id="wash"></div>
    <div id="shade-bottom"></div>

    <!-- ===== Pause ===== -->
    <div id="pause-screen" class="screen active">
        <div id="scene-line" class="eyebrow"></div>
        <div id="title">Paused</div>
        <div class="title-rule"></div>
        <div id="clock"></div>
        <div id="pause-list" class="options">
            <div class="option" data-action="resume"><div class="hl"></div><div class="bar"></div><div class="label">Resume</div><div class="meta"></div></div>
            <div class="option" data-action="restart"><div class="hl"></div><div class="bar"></div><div class="label">Restart scene</div><div class="meta"></div></div>
            <div class="option" data-action="settings"><div class="hl"></div><div class="bar"></div><div class="label">Settings</div><div class="meta"></div></div>
            <div class="option" data-action="main-menu"><div class="hl"></div><div class="bar"></div><div class="label">Main menu</div><div class="meta" id="main-menu-meta"></div></div>
            <div class="option" data-action="quit"><div class="hl"></div><div class="bar"></div><div class="label">Quit game</div><div class="meta" id="quit-meta"></div></div>
        </div>
        <div id="pause-desc" class="desc"></div>

        <!-- State the persistent script keeps from scene to scene -->
        <div id="session">
            <div id="session-accent"></div>
            <div class="eyebrow card-eyebrow">This session</div>
            <div class="stat" id="stat-1"><div class="stat-label">Time played</div><div class="stat-value" id="time-played"></div></div>
            <div class="stat" id="stat-2"><div class="stat-label">In this scene</div><div class="stat-value" id="time-scene"></div></div>
            <div class="stat" id="stat-3"><div class="stat-label">Scene loads</div><div class="stat-value" id="scene-loads"></div></div>
            <div class="stat" id="stat-4"><div class="stat-label">Pauses</div><div class="stat-value" id="pauses"></div></div>
            <div id="route-label" class="stat-label">Route</div>
            <div id="route"></div>
            <div id="session-note"></div>
        </div>
    </div>

    <!-- ===== Settings (rows are generated by the script) ===== -->
    <div id="settings-screen" class="screen">
        <div class="eyebrow">Paused</div>
        <div class="screen-title">Settings</div>
        <div class="title-rule settings-rule"></div>
        <div class="screen-sub">Applies immediately. Not saved.</div>
        <div id="settings-list" class="options"></div>
        <div id="settings-desc" class="desc"></div>
    </div>

    <!-- ===== Footer: input hints (keyboard, mouse or gamepad) ===== -->
    <div id="footer">
        <div id="footer-rule"></div>
        <div class="hint" id="hint-1"><div class="key" id="key-1"></div><div class="hint-label" id="label-1"></div></div>
        <div class="hint" id="hint-2"><div class="key" id="key-2"></div><div class="hint-label" id="label-2"></div></div>
        <div class="hint" id="hint-3"><div class="key" id="key-3"></div><div class="hint-label" id="label-3"></div></div>
        <div class="hint" id="hint-4"><div class="key" id="key-4"></div><div class="hint-label" id="label-4"></div></div>
        <div id="frozen">Game time stopped</div>
    </div>

    <!-- ===== Confirmation (restart, main menu, quit) ===== -->
    <div id="confirm">
        <div class="dialog-panel">
            <div class="dialog-title" id="confirm-title"></div>
            <div class="dialog-text" id="confirm-text"></div>
            <div class="dialog-button" id="confirm-cancel">Cancel</div>
            <div class="dialog-button" id="confirm-ok"></div>
        </div>
    </div>

    <!-- To and from black around a scene load or quit -->
    <div id="fade"></div>
</div>
