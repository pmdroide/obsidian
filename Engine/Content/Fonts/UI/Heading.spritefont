<?xml version="1.0" encoding="utf-8"?>
<!-- Vista game UI font "heading" (GameUI): sized for a 1080-high design canvas. -->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Bahnschrift</FontName>
    <Size>24</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <DefaultCharacter>?</DefaultCharacter>
    <CharacterRegions>
      <CharacterRegion><Start>&#32;</Start><End>&#126;</End></CharacterRegion>
      <CharacterRegion><Start>&#160;</Start><End>&#255;</End></CharacterRegion>
      <CharacterRegion><Start>&#8211;</Start><End>&#8212;</End></CharacterRegion>
      <CharacterRegion><Start>&#8216;</Start><End>&#8217;</End></CharacterRegion>
      <CharacterRegion><Start>&#8220;</Start><End>&#8221;</End></CharacterRegion>
      <CharacterRegion><Start>&#8226;</Start><End>&#8226;</End></CharacterRegion>
      <CharacterRegion><Start>&#8230;</Start><End>&#8230;</End></CharacterRegion>
      <CharacterRegion><Start>&#8249;</Start><End>&#8250;</End></CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
