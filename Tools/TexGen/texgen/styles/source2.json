{
  "name": "source2",
  "description": "Half-Life: Alyx / Source 2 authoring discipline: delit albedo, PBR value ranges, worn painted metal, two-scale normals, soft AO.",
  "common": {
    "prompt_suffix": ", seamless tileable texture, top-down orthographic, flat even diffuse lighting, no shadows, no perspective",
    "negative_prompt": "perspective, shadows, highlights, specular reflections, text, watermark, vignette, cartoon",
    "dielectric_albedo_mean": [50, 220],
    "dielectric_albedo_clip": [25, 245],
    "clip_fraction": 0.005,
    "metal_albedo_luminance": [140, 250],
    "metal_color": [0.77, 0.78, 0.79],
    "max_saturation": 0.75,
    "roughness_min_std": 0.03,
    "ao_min": 0.35,
    "fallback_family": "stone"
  },
  "families": {
    "brick": {
      "keywords": ["brick", "masonry"],
      "prompt_suffix": ", photographed surface, worn, realistic, subtle grime",
      "roughness": [0.55, 0.95], "metal": "none", "normal_strength": 2.5, "scale_m": 1.5, "material_type": "Basic"
    },
