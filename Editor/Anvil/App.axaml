<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Anvil.App"
             xmlns:local="using:Anvil"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <FontFamily x:Key="AnvilFontFamily">avares://Avalonia.Fonts.Inter/Assets#Inter, Segoe UI, system-ui, sans-serif</FontFamily>

            <!-- Neutral dark greys with a blue editor accent. -->
            <SolidColorBrush x:Key="AnvilWindowBackgroundBrush"   Color="#1B1B1B" />
            <SolidColorBrush x:Key="AnvilTitleBarBackgroundBrush" Color="#151515" />
            <SolidColorBrush x:Key="AnvilPanelBackgroundBrush"    Color="#232323" />
            <SolidColorBrush x:Key="AnvilToolRailBackgroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="AnvilViewportBackgroundBrush" Color="#191919" />
            <SolidColorBrush x:Key="AnvilViewportGridBrush"       Color="#2B2B2B" />
            <SolidColorBrush x:Key="AnvilBorderBrush"             Color="#313131" />
            <SolidColorBrush x:Key="AnvilBorderStrongBrush"       Color="#3B3B3B" />
            <SolidColorBrush x:Key="AnvilInputBackgroundBrush"    Color="#161616" />
            <SolidColorBrush x:Key="AnvilSubtleBandBrush"         Color="#1E1E1E" />
            <SolidColorBrush x:Key="AnvilHoverBackgroundBrush"    Color="#2D2D2D" />
            <SolidColorBrush x:Key="AnvilSelectedBackgroundBrush" Color="#3273eb" />
            <SolidColorBrush x:Key="AnvilPrimaryBrush"            Color="#3273eb" />
            <SolidColorBrush x:Key="AnvilPrimaryAltBrush"         Color="#1452C4" />
            <SolidColorBrush x:Key="AnvilPlayBrush"               Color="#E06C5A" />
            <SolidColorBrush x:Key="AnvilTextPrimaryBrush"        Color="#E8E8E8" />
            <SolidColorBrush x:Key="AnvilTextSecondaryBrush"      Color="#C6C6C6" />
            <SolidColorBrush x:Key="AnvilTextMutedBrush"          Color="#8E8E8E" />
            <SolidColorBrush x:Key="AnvilTextSubtleBrush"         Color="#6A6A6A" />
            <SolidColorBrush x:Key="AnvilTextDisabledBrush"       Color="#4A4A4A" />

            <SolidColorBrush x:Key="AnvilLogBrush"     Color="#5D9CF7" />
            <SolidColorBrush x:Key="AnvilWarnBrush"    Color="#E0C34E" />
            <SolidColorBrush x:Key="AnvilErrorBrush"   Color="#E0524E" />
            <SolidColorBrush x:Key="AnvilMeshBrush"    Color="#A4ABFF" />
            <SolidColorBrush x:Key="AnvilCameraBrush"  Color="#4ED18A" />
            <SolidColorBrush x:Key="AnvilLightBrush"   Color="#E0C34E" />
            <SolidColorBrush x:Key="AnvilFolderBrush"  Color="#C9A86B" />
            <SolidColorBrush x:Key="AnvilScriptBrush"  Color="#7FB6FA" />
            <SolidColorBrush x:Key="AnvilTextureBrush" Color="#FA9E5A" />
            <SolidColorBrush x:Key="AnvilAudioBrush"   Color="#B98EFA" />
            <SolidColorBrush x:Key="AnvilPrefabBrush"  Color="#6FB8FF" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Anvil/Themes/InspectorControls.axaml" />
                <ResourceInclude Source="avares://LucideAvalonia/Lucide/ResourcesIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!-- ColorPicker/ColorView ship their control templates in a SEPARATE theme
             dictionary that FluentTheme does NOT pull in. Without this include the
             inspector's material ColorPicker has no template and renders as an empty
             flyout panel. Must come after FluentTheme so the base Theme* brushes it
             references via DynamicResource are already defined. -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
    </Application.Styles>
</Application>
