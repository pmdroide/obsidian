<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Anvil.ViewModels"
        xmlns:m="using:Anvil.Models"
        xmlns:input="using:Engine.InputDevices"
        xmlns:scripting="using:Engine.Scripting"
        xmlns:controls="using:Anvil.Controls"
        xmlns:conv="using:Anvil.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="Anvil.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/Icon.ico"
        Width="1440" Height="900"
        WindowStartupLocation="CenterScreen"
        MinWidth="1100" MinHeight="700"
        Background="{StaticResource AnvilWindowBackgroundBrush}"
        FontFamily="{StaticResource AnvilFontFamily}"
        Foreground="{StaticResource AnvilTextPrimaryBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="36"   
        Title="Anvil">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- Build shortcuts (File menu). -->
    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+B" Command="{Binding BuildAndRunCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+B" Command="{Binding BuildCommand}" />
    </Window.KeyBindings>

    <!-- Avalonia 12 draws its own title bar over the extended client area: hide its
         fullscreen caption button and its title text (it overlapped the brand mark). -->
    <Window.WindowDecorationsTheme>
        <ControlTheme TargetType="WindowDrawnDecorations"
                      BasedOn="{StaticResource {x:Type WindowDrawnDecorations}}">
            <Style Selector="^ /template/ Button#PART_FullScreenButton">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ Button#PART_PopoverFullScreenButton">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <!-- The panel's IsVisible is a template binding (beats styles); hide its text instead. -->
            <Style Selector="^ /template/ Panel#PART_TitleTextPanel > TextBlock">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </ControlTheme>
    </Window.WindowDecorationsTheme>

    <Window.Resources>
        <conv:EnumEqualsConverter x:Key="EnumEquals" />
        <conv:ColorToBrushConverter x:Key="ColorToBrush" />
    </Window.Resources>

    <Window.Styles>

        <!-- ============================== Global ============================== -->
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AnvilTextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AnvilFontFamily}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource AnvilTextMutedBrush}" />
        </Style>
        <Style Selector="TextBlock.subtle">
            <Setter Property="Foreground" Value="{StaticResource AnvilTextSubtleBrush}" />
        </Style>
        <Style Selector="TextBlock.panelTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Default LucideIcon style -->
        <Style Selector="controls|LucideIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource AnvilTextMutedBrush}" />
            <Setter Property="StrokeThickness" Value="1.6" />
        </Style>

        <!-- ============================== Menu (title bar) ============================== -->
        <Style Selector="Menu.titleMenu">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Menu.titleMenu > MenuItem">
            <Setter Property="Foreground" Value="{StaticResource AnvilTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="36" />
        </Style>
        <Style Selector="Menu.titleMenu > MenuItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource AnvilHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Menu.titleMenu > MenuItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource AnvilHoverBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource AnvilTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ============================== Tool rail buttons ============================== -->
        <Style Selector="Button.tool">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AnvilTextMutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AnvilHoverBackgroundBrush}" />
        </Style>
        <Style Selector="Button.tool.active">
            <Setter Property="Foreground" Value="{StaticResource AnvilTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.tool.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AnvilSelectedBackgroundBrush}" />
        </Style>
        <Style Selector="Button.tool.active controls|LucideIcon">
            <Setter Property="Foreground" Value="{StaticResource AnvilTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.tool.play.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AnvilPlayBrush}" />
        </Style>

        <!-- Smaller tool button used in toolbars -->
        <Style Selector="Button.iconButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource AnvilTextMutedBrush}" />
        </Style>
        <Style Selector="Button.iconButton:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AnvilHoverBackgroundBrush}" />
        </Style>
        <Style Selector="Button.iconButton controls|LucideIcon">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>

        <Style Selector="Button.environmentButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Foreground" Value="{StaticResource AnvilTextMutedBrush}" />
        </Style>
        <Style Selector="Button.environmentButton.active">
            <Setter Property="Foreground" Value="{StaticResource AnvilTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.environmentButton.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AnvilSelectedBackgroundBrush}" />
        </Style>

        <!-- Subtle row-level icon button (hierarchy lock/visible) -->
        <Style Selector="Button.rowIcon">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource AnvilTextSubtleBrush}" />
        </Style>
        <Style Selector="Button.rowIcon:pointerover">
            <Setter Property="Foreground" Value="{StaticResource AnvilTextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.rowIcon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AnvilHoverBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>

        <!-- ============================== Segmented ListBox ============================== -->
        <Style Selector="ListBox.segmented">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AnvilTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AnvilHoverBackgroundBrush}" />
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AnvilSelectedBackgroundBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource AnvilTextPrimaryBrush}" />
        </Style>
        <Style Selector="ListBox.segmented ListBoxItem:selected:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AnvilSelectedBackgroundBrush}" />
        </Style>

        <!-- ============================== Inputs ============================== -->
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="{StaticResource AnvilInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AnvilBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Foreground" Value="{StaticResource AnvilTextPrimaryBrush}" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="ComboBox.field">
            <Setter Property="Background" Value="{StaticResource AnvilInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AnvilBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Foreground" Value="{StaticResource AnvilTextPrimaryBrush}" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="NumericUpDown.field">
            <Setter Property="Background" Value="{StaticResource AnvilInputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AnvilBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Foreground" Value="{StaticResource AnvilTextPrimaryBrush}" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- ============================== TreeView ============================== -->
        <Style Selector="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource AnvilSelectedBackgroundBrush}" />
        </Style>
        <Style Selector="TreeViewItem:selected:focus /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource AnvilSelectedBackgroundBrush}" />
        </Style>
        <Style Selector="TreeViewItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{StaticResource AnvilHoverBackgroundBrush}" />
        </Style>

        <!-- ============================== ListBox (console list) ============================== -->
        <Style Selector="ListBox.console">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.console ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="ListBox.console ListBoxItem:nth-child(odd) /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AnvilSubtleBandBrush}" />
        </Style>
        <Style Selector="ListBox.console ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AnvilHoverBackgroundBrush}" />
        </Style>
        <Style Selector="ListBox.console ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AnvilSelectedBackgroundBrush}" />
        </Style>
        <Style Selector="ListBox.console ListBoxItem:selected:focus /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AnvilSelectedBackgroundBrush}" />
        </Style>

        <!-- ============================== Panel header ============================== -->
        <Style Selector="Border.panelHeader">
            <Setter Property="Background" Value="{StaticResource AnvilPanelBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AnvilBorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Height" Value="33" />
        </Style>

        <!-- ============================== Filter pill button ============================== -->
        <Style Selector="Button.pill">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource AnvilTextSecondaryBrush}" />
        </Style>
        <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AnvilHoverBackgroundBrush}" />
        </Style>
        <Style Selector="Button.pill.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AnvilSelectedBackgroundBrush}" />
        </Style>

        <!-- ============================== Expander ============================== -->
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource AnvilBorderBrush}" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton">
            <Setter Property="Background" Value="{StaticResource AnvilSubtleBandBrush}" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <!-- ============================== ScrollBar ============================== -->
        <Style Selector="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

    <!-- ============================ ROOT GRID ============================ -->
    <Grid RowDefinitions="36,*,176">

        <!-- ============================== TITLE BAR ============================== -->
        <Border Grid.Row="0"
                Background="{StaticResource AnvilTitleBarBackgroundBrush}"
                BorderBrush="{StaticResource AnvilBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,0"
                PointerPressed="TitleBar_PointerPressed">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                <!-- brand mark -->
                <Image Grid.Column="0" Width="24" Height="24" Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Source="/Assets/Icon.ico" />

                <!-- menu bar -->
                <Menu Grid.Column="1" Classes="titleMenu" VerticalAlignment="Center">
                    <MenuItem Header="File">
                        <MenuItem Header="New Scene" Command="{Binding NewSceneCommand}" />
                        <MenuItem Header="Open Scene..." Command="{Binding OpenSceneCommand}"
                                  CommandParameter="{Binding $parent[Window]}" />
                        <Separator />
                        <MenuItem Header="Save" Command="{Binding SaveSceneCommand}"
                                  CommandParameter="{Binding $parent[Window]}" />
                        <MenuItem Header="Save As..." Command="{Binding SaveSceneAsCommand}"
                                  CommandParameter="{Binding $parent[Window]}" />
                        <Separator />
                        <MenuItem Header="Build..." Command="{Binding BuildCommand}"
                                  CommandParameter="{Binding $parent[Window]}" InputGesture="Ctrl+Shift+B" />
                        <MenuItem Header="Build and Run" Command="{Binding BuildAndRunCommand}" InputGesture="Ctrl+B" />
                        <MenuItem Header="Cancel Build" Command="{Binding CancelBuildCommand}"
                                  IsVisible="{Binding IsBuilding}" />
                        <Separator />
                        <MenuItem Header="Exit" />
                    </MenuItem>
                    <MenuItem Header="Edit">
                        <MenuItem Header="Undo" />
                        <MenuItem Header="Redo" />
                        <Separator />
                        <MenuItem Header="Project Settings..."
                                  Command="{Binding OpenProjectSettingsCommand}"
                                  CommandParameter="{Binding $parent[Window]}" />
                    </MenuItem>
                    <!-- Spawns at the camera focus (IEditorBridge.SpawnPoint). The parameter is an
                         Assets model field name. Every gameobject needs a mesh, so there is no
                         Create Empty, and there is no capsule mesh in Content yet. -->
                    <MenuItem Header="GameObject">
                        <MenuItem Header="3D Object">
                            <MenuItem Header="Cube"
                                      Command="{Binding AddEntityCommand}"
                                      CommandParameter="Cube" />
                            <MenuItem Header="Sphere"
                                      Command="{Binding AddEntityCommand}"
                                      CommandParameter="IsoSphere" />
                        </MenuItem>
                        <MenuItem Header="Light">
                            <MenuItem Header="Directional Light"
                                      Command="{Binding AddDirectionalLightCommand}" />
                            <MenuItem Header="Point Light"
                                      Command="{Binding AddPointLightCommand}" />
                            <MenuItem Header="Spot Light"
                                      Command="{Binding AddSpotLightCommand}" />
                        </MenuItem>
                        <MenuItem Header="Effects">
                            <MenuItem Header="Particle System"
                                      Command="{Binding AddParticleSystemCommand}" />
                        </MenuItem>
                        <MenuItem Header="Nature">
                            <MenuItem Header="Tree"
                                      Command="{Binding AddTreeCommand}" />
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="Game Settings"
                              Command="{Binding OpenGameSettingsCommand}"
                              CommandParameter="{Binding $parent[Window]}" />
                    <MenuItem Header="Window">
                        <MenuItem Header="Input"
                                  Command="{Binding SetInspectorViewCommand}"
                                  CommandParameter="Input" />
                        <MenuItem Header="Steam"
                                  Command="{Binding SetInspectorViewCommand}"
                                  CommandParameter="Steam" />
                        <MenuItem Header="Hierarchy" />
                        <MenuItem Header="Inspector" />
                        <MenuItem Header="Console" />
                        <MenuItem Header="Post Processing"
                                  Command="{Binding SetInspectorViewCommand}"
                                  CommandParameter="PostProcessing" />
                        <MenuItem Header="Lighting"
                                  Command="{Binding SetInspectorViewCommand}"
                                  CommandParameter="Lighting" />
                    </MenuItem>
                    <MenuItem Header="Help">
                        <MenuItem Header="Anvil Docs" />
                    </MenuItem>
                </Menu>

                <!-- doc status -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="6">
                    <TextBlock Text="{Binding ProjectName}" FontSize="12"
                               Foreground="{StaticResource AnvilTextDisabledBrush}" />
                    <TextBlock Text="-" FontSize="12"
                               Foreground="{StaticResource AnvilTextDisabledBrush}" />
                    <TextBlock Text="{Binding SceneName}" FontSize="12"
                               Foreground="{StaticResource AnvilTextDisabledBrush}" />
                    <TextBlock Text="-" FontSize="12"
                               Foreground="{StaticResource AnvilTextDisabledBrush}" />
                    <TextBlock Text="{Binding Platform}" FontSize="12"
                               Foreground="{StaticResource AnvilTextDisabledBrush}" />
                </StackPanel>

                <!-- render stats -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="0,0,136,0">
                    <Border CornerRadius="4" Padding="6,2"
                            Background="{StaticResource AnvilInputBackgroundBrush}">
                        <TextBlock Text="{Binding GraphicsApi}" FontSize="10"
                                   Foreground="{StaticResource AnvilTextSecondaryBrush}" />
                    </Border>
                    <Border CornerRadius="4" Padding="6,2"
                            Background="{StaticResource AnvilInputBackgroundBrush}">
                        <TextBlock FontSize="10" Foreground="{StaticResource AnvilTextSecondaryBrush}">
                            <Run Text="{Binding Fps}" /><Run Text="fps" />
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================== MAIN ============================== -->
        <Grid Grid.Row="1" ColumnDefinitions="48,*,260">

            <!-- ====== TOOL RAIL ====== -->
            <Border Grid.Column="0"
                    Background="{StaticResource AnvilToolRailBackgroundBrush}"
                    BorderBrush="{StaticResource AnvilBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="0,12">
                <DockPanel HorizontalAlignment="Center">

                    <!-- bottom group -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Vertical" Spacing="6">
                        <Border Height="1" Background="{StaticResource AnvilBorderBrush}" Margin="6,4" />
                        <Button Classes="tool play"
                                Classes.active="{Binding IsPlaying}"
                                Command="{Binding TogglePlayCommand}"
                                ToolTip.Tip="Play / Pause (Space)">
                            <Grid>
                                <controls:LucideIcon Icon="Play" IsVisible="{Binding !IsPlaying}" />
                                <controls:LucideIcon Icon="Pause" IsVisible="{Binding IsPlaying}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                    <!-- top tools -->
                    <StackPanel Orientation="Vertical" Spacing="6">
                        <Button Classes="tool" Classes.active="{Binding IsToolSelect}"
                                Command="{Binding SetActiveToolCommand}" CommandParameter="Select"
                                ToolTip.Tip="Select (Q)">
                            <controls:LucideIcon Icon="MousePointer2" />
                        </Button>
                        <Button Classes="tool" Classes.active="{Binding IsToolMove}"
                                Command="{Binding SetActiveToolCommand}" CommandParameter="Move"
                                ToolTip.Tip="Move (W)">
                            <controls:LucideIcon Icon="Move" />
                        </Button>
                        <Button Classes="tool" Classes.active="{Binding IsToolRotate}"
                                Command="{Binding SetActiveToolCommand}" CommandParameter="Rotate"
                                ToolTip.Tip="Rotate (E)">
                            <controls:LucideIcon Icon="RotateCw" />
                        </Button>
                        <Button Classes="tool" Classes.active="{Binding IsToolScale}"
                                Command="{Binding SetActiveToolCommand}" CommandParameter="Scale"
                                ToolTip.Tip="Scale (R)">
                            <controls:LucideIcon Icon="Maximize2" />
                        </Button>
                        <Button Classes="tool" Classes.active="{Binding IsToolPan}"
                                Command="{Binding SetActiveToolCommand}" CommandParameter="Pan"
                                ToolTip.Tip="Pan (Space)">
                            <controls:LucideIcon Icon="Hand" />
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ====== CENTER (viewport) ====== -->
            <Grid Grid.Column="1" RowDefinitions="33,*"
                  Background="{StaticResource AnvilViewportBackgroundBrush}">

                <!-- viewport toolbar -->
                <Border Grid.Row="0"
                        Background="{StaticResource AnvilPanelBackgroundBrush}"
                        BorderBrush="{StaticResource AnvilBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="12,6">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">

                        <Button Grid.Column="0" Content="Environment" Classes="environmentButton"
                                Command="{Binding SetInspectorViewCommand}" CommandParameter="Environment"
                                Classes.active="{Binding IsInspectorEnvironmentView}"
                                ToolTip.Tip="Skybox and day / night cycle" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="World" Classes="environmentButton" Margin="4,0,0,0"
                                Command="{Binding SetInspectorViewCommand}" CommandParameter="World"
                                Classes.active="{Binding IsInspectorWorldView}"
                                ToolTip.Tip="World generation (voxel world)" VerticalAlignment="Center" />

                        <Rectangle Grid.Column="2" Width="1" Margin="10,4"
                                   Fill="{StaticResource AnvilBorderBrush}" />

                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="2"
                                    VerticalAlignment="Center">
                            <Button Classes="iconButton" Classes.active="{Binding IsAudioEnabled}"
                                    Command="{Binding ToggleAudioCommand}" ToolTip.Tip="{Binding AudioToggleTip}"
                                    AutomationProperties.Name="Game audio">
                                <controls:LucideIcon Icon="{Binding AudioIcon}" />
                            </Button>
                            <Button Classes="iconButton" ToolTip.Tip="Camera">
                                <controls:LucideIcon Icon="Camera" />
                            </Button>
                            <Button Classes="iconButton" ToolTip.Tip="Lighting">
                                <controls:LucideIcon Icon="Sun" />
                            </Button>
                            <Button Classes="iconButton" ToolTip.Tip="Layers">
                                <controls:LucideIcon Icon="Layers" />
                            </Button>
                            <Button Classes="iconButton" Classes.active="{Binding IsGridVisible}"
                                    Command="{Binding ToggleGridCommand}" ToolTip.Tip="{Binding GridToggleTip}"
                                    AutomationProperties.Name="Ground grid">
                                <controls:LucideIcon Icon="Grid3x3" />
                            </Button>
                            <Button Classes="iconButton" Classes.active="{Binding IsStatsVisible}"
                                    Command="{Binding ToggleStatsCommand}" ToolTip.Tip="{Binding StatsToggleTip}"
                                    AutomationProperties.Name="Debug stats">
                                <controls:LucideIcon Icon="Monitor" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- viewport scene -->
                <Grid Grid.Row="1">
                    <controls:MonoGameHost x:Name="ViewportHost" />

                    <!-- Invisible keyboard sink. The embedded engine receives keys only via
                         Avalonia TopLevel KeyDown forwarding (MonoGameHost.OnTopLevelKeyDown),
                         which fires only while a MANAGED element holds focus. Maximize/fullscreen
                         clears focus and the host can't be the target (focusing a NativeControlHost
                         hands OS focus to the engine child, where MonoGame's keyboard reads empty),
                         so MonoGameHost re-focuses this plain Border to keep WASD/camera keys alive.
                         IsHitTestVisible=False so it never intercepts viewport mouse input. -->
                    <Border x:Name="ViewportKeyboardSink"
                            Focusable="True" IsHitTestVisible="False"
                            Width="1" Height="1" Opacity="0"
                            HorizontalAlignment="Left" VerticalAlignment="Top" />

                    <!-- bottom-left view label -->
                    <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                Margin="14,0,0,14" Spacing="2">
                        <TextBlock Text="{Binding ViewMode}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource AnvilTextSubtleBrush}"
                                   LetterSpacing="2" />
                        <TextBlock Text="{Binding PlayStateLabel}" FontSize="10"
                                   Foreground="{StaticResource AnvilTextSubtleBrush}" />
                    </StackPanel>

                    <!-- selection label bottom-right -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Margin="0,0,14,14" Padding="8,4" CornerRadius="4"
                            Background="#22000000"
                            BorderBrush="{StaticResource AnvilBorderBrush}"
                            BorderThickness="1"
                            IsVisible="{Binding HasSelectedObject}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Selected:" FontSize="10"
                                       Foreground="{StaticResource AnvilTextMutedBrush}" />
                            <TextBlock Text="{Binding SelectedObjectName}" FontSize="10"
                                       Foreground="{StaticResource AnvilTextPrimaryBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- PLAYING indicator -->
                    <Border IsVisible="{Binding IsPlaying}"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,12,12,0" Padding="8,4" CornerRadius="4"
                            Background="#22E06C5A"
                            BorderBrush="#44E06C5A" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AnvilPlayBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="PLAYING" FontSize="11" FontWeight="SemiBold"
                                       LetterSpacing="1"
                                       Foreground="{StaticResource AnvilPlayBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ====== RIGHT PANEL (Hierarchy + Inspector) ====== -->
            <Grid Grid.Column="2" RowDefinitions="45*,4,55*"
                  Background="{StaticResource AnvilPanelBackgroundBrush}">
                <Grid.Styles>
                    <Style Selector="Border.column">
                        <Setter Property="BorderBrush" Value="{StaticResource AnvilBorderBrush}" />
                        <Setter Property="BorderThickness" Value="1,0,0,0" />
                    </Style>
                </Grid.Styles>

                <!-- Hierarchy -->
                <Border Grid.Row="0" Classes="column">
                    <Grid RowDefinitions="33,22,*">

                        <Border Grid.Row="0" Classes="panelHeader">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal"
                                            Spacing="6" VerticalAlignment="Center">
                                    <controls:LucideIcon Icon="Layers" />
                                    <TextBlock Text="Hierarchy" Classes="panelTitle" />
                                </StackPanel>
                                <Button Grid.Column="2" Classes="iconButton" ToolTip.Tip="Add">
                                    <controls:LucideIcon Icon="Plus" />
                                    <Button.Flyout>
                                        <!-- Data-driven add-object menu. MenuFlyout items don't inherit
                                             DataContext from the placement target reliably, so the
                                             ItemsSource reaches back through the Window's DataContext
                                             explicitly; each generated MenuItem's DataContext is an
                                             AddableObjectType, bound via the ItemContainerTheme. Adding a
                                             new object type is one line in MainWindowViewModel.AttachBridge. -->
                                        <MenuFlyout ItemsSource="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).AddableObjects}">
                                            <MenuFlyout.ItemContainerTheme>
                                                <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                                              x:DataType="m:AddableObjectType">
                                                    <Setter Property="Header" Value="{Binding DisplayName}" />
                                                    <Setter Property="Command" Value="{Binding AddCommand}" />
                                                </ControlTheme>
                                            </MenuFlyout.ItemContainerTheme>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Padding="12,2,12,0">
                            <TextBlock Text="Scene" FontSize="10"
                                       LetterSpacing="1.5"
                                       Foreground="{StaticResource AnvilTextSubtleBrush}"
                                       VerticalAlignment="Center" />
                        </Border>

                        <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                            <TreeView Name="HierarchyTreeView"
                                      ItemsSource="{Binding SceneObjects}"
                                      SelectedItem="{Binding SelectedSceneObject, Mode=TwoWay}"
                                      DragDrop.AllowDrop="True"
                                      DragDrop.DragOver="Hierarchy_DragOver"
                                      DragDrop.Drop="Hierarchy_Drop">
                                <TreeView.KeyBindings>
                                    <KeyBinding Gesture="Delete"
                                                Command="{Binding DeleteSelectedCommand}" />
                                </TreeView.KeyBindings>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate DataType="m:SceneObjectViewModel"
                                                      ItemsSource="{Binding Children}">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Height="22">
                                            <Grid.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Delete"
                                                              Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).DeleteSceneObjectCommand}"
                                                              CommandParameter="{Binding}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>

                                            <!-- type icon -->
                                            <Grid Grid.Column="0" Width="14" Height="14"
                                                  VerticalAlignment="Center" Margin="0,0,6,0">
                                                <controls:LucideIcon Icon="Box"
                                                    Foreground="{StaticResource AnvilMeshBrush}"
                                                    IsVisible="{Binding Type, Converter={StaticResource EnumEquals}, ConverterParameter=Mesh}" />
                                                <controls:LucideIcon Icon="Lightbulb"
                                                    Foreground="{StaticResource AnvilLightBrush}"
                                                    IsVisible="{Binding Type, Converter={StaticResource EnumEquals}, ConverterParameter=Light}" />
                                                <controls:LucideIcon Icon="Camera"
                                                    Foreground="{StaticResource AnvilCameraBrush}"
                                                    IsVisible="{Binding Type, Converter={StaticResource EnumEquals}, ConverterParameter=Camera}" />
                                                <controls:LucideIcon Icon="Circle"
                                                    IsVisible="{Binding Type, Converter={StaticResource EnumEquals}, ConverterParameter=Empty}" />
                                                <controls:LucideIcon Icon="Folder"
                                                    Foreground="{StaticResource AnvilFolderBrush}"
                                                    IsVisible="{Binding Type, Converter={StaticResource EnumEquals}, ConverterParameter=Group}" />
                                            </Grid>

                                            <!-- name -->
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       FontSize="11.5"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource AnvilTextPrimaryBrush}" />

                                            <!-- lock toggle -->
                                            <Button Grid.Column="2" Classes="rowIcon"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleSceneObjectLockedCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Lock">
                                                <Grid>
                                                    <controls:LucideIcon Icon="Lock"
                                                          Width="12" Height="12"
                                                          IsVisible="{Binding Locked}" />
                                                    <controls:LucideIcon Icon="LockOpen"
                                                          Width="12" Height="12"
                                                          Foreground="{StaticResource AnvilTextDisabledBrush}"
                                                          IsVisible="{Binding !Locked}" />
                                                </Grid>
                                            </Button>

                                            <!-- visible toggle -->
                                            <Button Grid.Column="3" Classes="rowIcon"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleSceneObjectVisibleCommand}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip.Tip="Visible">
                                                <Grid>
                                                    <controls:LucideIcon Icon="Eye"
                                                          Width="12" Height="12"
                                                          IsVisible="{Binding Visible}" />
                                                    <controls:LucideIcon Icon="EyeOff"
                                                          Width="12" Height="12"
                                                          Foreground="{StaticResource AnvilTextDisabledBrush}"
                                                          IsVisible="{Binding !Visible}" />
                                                </Grid>
                                            </Button>
                                        </Grid>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- splitter -->
                <GridSplitter Grid.Row="1" Height="4"
                              HorizontalAlignment="Stretch"
                              Background="{StaticResource AnvilBorderBrush}"
                              ResizeDirection="Rows" />

                <!-- Inspector -->
                <Border Grid.Row="2" Classes="column">
                    <Grid RowDefinitions="33,*">

                        <Border Grid.Row="0" Classes="panelHeader">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <controls:LucideIcon Grid.Column="0" Icon="Settings"
                                                     VerticalAlignment="Center"
                                                     ToolTip.Tip="Inspector" />

                                <!-- Inspector view switch — Selection vs Post Processing.
                                     Replaces the legacy HelperSuite right-side options panel;
                                     the Window > Post Processing menu entry also flips this.
                                     The tabs are the header title: the 260px column has no room
                                     for an "Inspector" label beside three tabs. -->
                                <UniformGrid Grid.Column="1" Rows="1" Columns="3"
                                             VerticalAlignment="Center">
                                    <UniformGrid.Styles>
                                        <Style Selector="Button.pill">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                                            <Setter Property="Margin" Value="1,0" />
                                        </Style>
                                    </UniformGrid.Styles>
                                    <Button Content="Selection" Classes="pill"
                                            Command="{Binding SetInspectorViewCommand}"
                                            CommandParameter="Selection"
                                            Classes.active="{Binding IsInspectorSelectionView}" />
                                    <Button Content="Post FX" Classes="pill"
                                            Command="{Binding SetInspectorViewCommand}"
                                            CommandParameter="PostProcessing"
                                            Classes.active="{Binding IsInspectorPostProcessingView}" />
                                    <Button Content="Lighting" Classes="pill"
                                            Command="{Binding SetInspectorViewCommand}"
                                            CommandParameter="Lighting"
                                            Classes.active="{Binding IsInspectorLightingView}" />
                                </UniformGrid>
                            </Grid>
                        </Border>

                        <!-- Input devices section opened from Window > Input. -->
                        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsInspectorInputView}"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel DataContext="{Binding InputDevices}" x:DataType="m:InputDevicesViewModel"
                                        Spacing="12" Margin="14,12">
                                <TextBlock Text="Input" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Available inputs" FontWeight="SemiBold" FontSize="11.5" />
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
                                    <TextBlock Text="Keyboard" Margin="0,0,12,10" />
                                    <TextBlock Grid.Column="1" Text="{Binding KeyboardStatus}" Classes="muted" />
                                    <TextBlock Grid.Row="1" Text="Mouse" Margin="0,0,12,10" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MouseStatus}" Classes="muted" />
                                    <TextBlock Grid.Row="2" Text="Controller" Margin="0,0,12,10" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ControllerStatus}" Classes="muted" />
                                    <TextBlock Grid.Row="3" Text="Touch" Margin="0,0,12,10" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TouchStatus}" Classes="muted" />
                                    <TextBlock Grid.Row="4" Text="Pen" Margin="0,0,12,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PenStatus}" Classes="muted" />
                                </Grid>
                                <Separator />
                                <TextBlock Text="Connected controllers" FontWeight="SemiBold" FontSize="11.5" />
                                <ItemsControl ItemsSource="{Binding Controllers}" IsVisible="{Binding HasControllers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="input:ControllerDeviceSnapshot">
                                            <Border Background="{StaticResource AnvilInputBackgroundBrush}"
                                                    BorderBrush="{StaticResource AnvilBorderBrush}" BorderThickness="1"
                                                    CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                                <StackPanel Spacing="5">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="1" Text="{Binding PlayerLabel}"
                                                                   Classes="muted" Margin="8,0,0,0" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding Type}" Classes="muted" FontSize="11" />
                                                    <TextBlock Text="{Binding Features}" Classes="subtle" TextWrapping="Wrap" FontSize="11" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding EmptyControllerMessage}" IsVisible="{Binding !HasControllers}"
                                           TextWrapping="Wrap" Classes="muted" FontSize="11" />
                                <TextBlock Text="Updates automatically as devices connect or disconnect. Controller detection supports Xbox-compatible controllers."
                                           TextWrapping="Wrap" Classes="subtle" FontSize="11" />
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="11" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Steam connection section opened from Window > Steam. -->
                        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsInspectorSteamView}"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel DataContext="{Binding Steam}" x:DataType="m:SteamViewModel"
                                        Spacing="12" Margin="14,12">
                                <TextBlock Text="Steam" FontSize="14" FontWeight="SemiBold" />
                                <CheckBox Content="Enable Steam" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          IsEnabled="{Binding CanToggleSteam}" />
                                <TextBlock Text="App ID" Classes="muted" />
                                <Grid ColumnDefinitions="*,Auto">
                                    <NumericUpDown Value="{Binding AppId, Mode=TwoWay}"
                                                   Minimum="1" Maximum="4294967295" Increment="1" FormatString="0"
                                                   IsEnabled="{Binding !IsBusy}" />
                                    <Button Grid.Column="1" Content="Apply" Margin="8,0,0,0"
                                            Command="{Binding ApplyAppIdCommand}" />
                                </Grid>
                                <TextBlock Text="480 is Spacewar. The enable preference is remembered. Apply saves the App ID and reconnects Steam when enabled."
                                           Classes="muted" TextWrapping="Wrap" FontSize="11" />
                                <TextBlock Text="Enter a whole App ID between 1 and 4294967295."
                                           IsVisible="{Binding !IsValidAppId}" TextWrapping="Wrap" FontSize="11" />
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                                    <TextBlock Text="Status" Classes="subtle" Margin="0,0,14,8" />
                                    <TextBlock Grid.Column="1" Text="{Binding ConnectionState}" />
                                    <TextBlock Grid.Row="1" Text="Account" Classes="subtle" Margin="0,0,14,8" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PersonaName}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="Steam ID" Classes="subtle" Margin="0,0,14,0" />
                                    <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SteamId}" />
                                </Grid>
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="11" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Connect" Command="{Binding ConnectCommand}" />
                                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}" />
                                </StackPanel>
                                <Separator />
                                <TextBlock Text="Future Steam features" FontWeight="SemiBold" />
                                <TextBlock Text="Achievements and peer-to-peer lobbies will use this Steam connection."
                                           Classes="muted" TextWrapping="Wrap" FontSize="11" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Empty selection state. -->
                        <TextBlock Grid.Row="1"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource AnvilTextDisabledBrush}"
                                   Text="Nothing selected">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsInspectorSelectionView" />
                                    <Binding Path="HasNoSelectedObject" />
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>

                        <!-- populated (Selection view) -->
                        <ScrollViewer Grid.Row="1" x:Name="InspectorScroll"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="IsInspectorSelectionView" />
                                    <Binding Path="HasSelectedObject" />
                                </MultiBinding>
                            </ScrollViewer.IsVisible>
                            <StackPanel Spacing="0" DataContext="{Binding SelectedObject}"
                                        x:DataType="m:SceneObjectViewModel">

                                <!-- meta -->
                                <Border Padding="12,10" Background="{StaticResource AnvilSubtleBandBrush}"
                                        BorderBrush="{StaticResource AnvilBorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel Spacing="8">
                                        <TextBox Classes="field"
                                                 Text="{Binding Name, Mode=TwoWay}" />
                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="6"
                                              RowDefinitions="Auto,Auto" RowSpacing="3">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Tag"
                                                       Classes="muted" FontSize="10" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Layer"
                                                       Classes="muted" FontSize="10" />
                                            <ComboBox Grid.Row="1" Grid.Column="0" Classes="field"
                                                      HorizontalAlignment="Stretch"
                                                      SelectedItem="{Binding Tag, Mode=TwoWay}">
                                                <ComboBoxItem>Untagged</ComboBoxItem>
                                                <ComboBoxItem>Player</ComboBoxItem>
                                                <ComboBoxItem>Enemy</ComboBoxItem>
                                                <ComboBoxItem>static</ComboBoxItem>
                                                <ComboBoxItem>renderable</ComboBoxItem>
                                            </ComboBox>
                                            <ComboBox Grid.Row="1" Grid.Column="1" Classes="field"
                                                      HorizontalAlignment="Stretch"
                                                      SelectedItem="{Binding Layer, Mode=TwoWay}">
                                                <ComboBoxItem>Default</ComboBoxItem>
                                                <ComboBoxItem>UI</ComboBoxItem>
                                                <ComboBoxItem>IgnoreRaycast</ComboBoxItem>
                                            </ComboBox>
                                        </Grid>
                                        <Grid ColumnDefinitions="60,*" ColumnSpacing="8" IsVisible="{Binding HasRole}">
                                            <TextBlock Grid.Column="0" Text="Role" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                      ItemsSource="{x:Static m:SceneObjectViewModel.Roles}"
                                                      SelectedItem="{Binding Role, Mode=TwoWay}" />
                                        </Grid>
                                        <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding IsWaterRole}"
                                                   Text="Water volume: bodies with Buoyancy float below its top surface, riding its waves. It builds no collider." />
                                        <CheckBox Content="Persistent" IsChecked="{Binding Persistent, Mode=TwoWay}" FontSize="11"
                                                  IsVisible="{Binding HasRole}"
                                                  ToolTip.Tip="Keep this gameobject, with its scripts still running, when a script loads another scene during Play (like Unity's DontDestroyOnLoad)." />
                                    </StackPanel>
                                </Border>

                                <!-- Transform -->
                                <Expander IsExpanded="True">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LucideIcon Icon="Move3d" />
                                            <TextBlock Text="Transform" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="6" Margin="12,8,12,12">
                                        <Grid ColumnDefinitions="60,*" RowDefinitions="Auto,Auto,Auto"
                                              RowSpacing="6">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Position"
                                                       Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <Grid Grid.Row="0" Grid.Column="1"
                                                  ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                                <NumericUpDown Grid.Column="0" Classes="field"
                                                               Value="{Binding PositionX, Mode=TwoWay}"
                                                               ShowButtonSpinner="False" FormatString="0.#" />
                                                <NumericUpDown Grid.Column="1" Classes="field"
                                                               Value="{Binding PositionY, Mode=TwoWay}"
                                                               ShowButtonSpinner="False" FormatString="0.#" />
                                                <NumericUpDown Grid.Column="2" Classes="field"
                                                               Value="{Binding PositionZ, Mode=TwoWay}"
                                                               ShowButtonSpinner="False" FormatString="0.#" />
                                            </Grid>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Rotation"
                                                       Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <Grid Grid.Row="1" Grid.Column="1"
                                                  ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                                <NumericUpDown Grid.Column="0" Classes="field"
                                                               Value="{Binding RotationX, Mode=TwoWay}"
                                                               ShowButtonSpinner="False" FormatString="0.#" />
                                                <NumericUpDown Grid.Column="1" Classes="field"
                                                               Value="{Binding RotationY, Mode=TwoWay}"
                                                               ShowButtonSpinner="False" FormatString="0.#" />
                                                <NumericUpDown Grid.Column="2" Classes="field"
                                                               Value="{Binding RotationZ, Mode=TwoWay}"
                                                               ShowButtonSpinner="False" FormatString="0.#" />
                                            </Grid>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Scale"
                                                       Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <Grid Grid.Row="2" Grid.Column="1"
                                                  ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                                <NumericUpDown Grid.Column="0" Classes="field"
                                                               Value="{Binding ScaleX, Mode=TwoWay}"
                                                               ShowButtonSpinner="False" FormatString="0.#" />
                                                <NumericUpDown Grid.Column="1" Classes="field"
                                                               Value="{Binding ScaleY, Mode=TwoWay}"
                                                               ShowButtonSpinner="False" FormatString="0.#" />
                                                <NumericUpDown Grid.Column="2" Classes="field"
                                                               Value="{Binding ScaleZ, Mode=TwoWay}"
                                                               ShowButtonSpinner="False" FormatString="0.#" />
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!-- Light -->
                                <Expander IsExpanded="True"
                                          IsVisible="{Binding Light, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LucideIcon Icon="Lightbulb"
                                                  Foreground="{StaticResource AnvilLightBrush}" />
                                            <TextBlock Text="Light" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="8" Margin="12,8,12,12"
                                                DataContext="{Binding Light}"
                                                x:DataType="m:LightInfo">
                                        <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Type"
                                                       Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" Classes="field"
                                                      HorizontalAlignment="Stretch"
                                                      IsEnabled="False"
                                                      SelectedItem="{Binding Type, Mode=TwoWay}">
                                                <m:LightType>Directional</m:LightType>
                                                <m:LightType>Point</m:LightType>
                                                <m:LightType>Spot</m:LightType>
                                            </ComboBox>
                                        </Grid>
                                        <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Color"
                                                       Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Background="Transparent"
                                                    BorderThickness="0" Padding="0"
                                                    HorizontalAlignment="Left">
                                                <Border Width="28" Height="20" CornerRadius="3"
                                                        Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                                        BorderBrush="{StaticResource AnvilBorderBrush}"
                                                        BorderThickness="1" />
                                                <Button.Flyout>
                                                    <Flyout Opening="OwnedFlyout_Opening">
                                                        <ColorPicker x:DataType="m:LightInfo" Color="{Binding Color, Mode=TwoWay}" />
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                        </Grid>
                                        <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Intensity"
                                                       Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Column="1" Classes="field"
                                                           Value="{Binding Intensity, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.##" />
                                        </Grid>
                                        <Grid ColumnDefinitions="60,*" ColumnSpacing="8"
                                              IsVisible="{Binding HasRadius}">
                                            <TextBlock Grid.Column="0" Text="Radius"
                                                       Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Column="1" Classes="field"
                                                           Value="{Binding Radius, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.#" />
                                        </Grid>
                                        <!-- Spot cone: full angles in degrees; the edge fades from Inner to Spot Angle. -->
                                        <Grid ColumnDefinitions="60,*,40" ColumnSpacing="8"
                                              IsVisible="{Binding IsSpot}">
                                            <TextBlock Grid.Column="0" Text="Spot Angle"
                                                       Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="1" Maximum="179"
                                                    Value="{Binding SpotAngle, Mode=TwoWay}"
                                                    MinHeight="18" />
                                            <TextBlock Grid.Column="2" Text="{Binding SpotAngle, StringFormat={}{0:0}°}"
                                                       Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid ColumnDefinitions="60,*,40" ColumnSpacing="8"
                                              IsVisible="{Binding IsSpot}">
                                            <TextBlock Grid.Column="0" Text="Inner"
                                                       Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="{Binding SpotAngle}"
                                                    Value="{Binding InnerSpotAngle, Mode=TwoWay}"
                                                    MinHeight="18" />
                                            <TextBlock Grid.Column="2" Text="{Binding InnerSpotAngle, StringFormat={}{0:0}°}"
                                                       Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <CheckBox Content="Cast Shadows"
                                                  IsChecked="{Binding CastShadows, Mode=TwoWay}"
                                                  FontSize="11" />
                                    </StackPanel>
                                </Expander>

                                <!-- Components use typed templates so new editors can be added independently. -->
                                <ItemsControl ItemsSource="{Binding Components}">
                                    <ItemsControl.DataTemplates>
                                        <DataTemplate DataType="m:MaterialInfo" x:DataType="m:MaterialInfo">
                                            <Expander IsExpanded="True">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:LucideIcon Icon="Palette" />
                                                        <TextBlock Text="Material" FontSize="11.5"
                                                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Spacing="8" Margin="12,8,12,12">
                                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" FontSize="11" />

                                                    <Grid ColumnDefinitions="60,*" RowDefinitions="Auto"
                                                          ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Color"
                                                                   Classes="muted" FontSize="11"
                                                                   VerticalAlignment="Center" />
                                                        <Button Grid.Column="1" Background="Transparent"
                                                                BorderThickness="0" Padding="0"
                                                                HorizontalAlignment="Left">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Border Width="28" Height="20" CornerRadius="3"
                                                                        Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                                                        BorderBrush="{StaticResource AnvilBorderBrush}"
                                                                        BorderThickness="1" />
                                                                <TextBlock Text="{Binding ColorHex}" FontSize="11"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <Button.Flyout>
                                                                <!-- Flyout content is outside the template tree; OwnedFlyout_Opening
                                                                     pins it to this component so it never edits another object. -->
                                                                <Flyout Opening="OwnedFlyout_Opening">
                                                                    <ColorPicker x:DataType="m:MaterialInfo" Color="{Binding Color, Mode=TwoWay}" />
                                                                </Flyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="60,*,40" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Roughness"
                                                                   Classes="muted" FontSize="11"
                                                                   VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                                                Value="{Binding Roughness, Mode=TwoWay}"
                                                                MinHeight="18" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Roughness, StringFormat={}{0:0.00}}"
                                                                   Classes="muted" FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>

                                                    <Grid ColumnDefinitions="60,*,40" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Metallic"
                                                                   Classes="muted" FontSize="11"
                                                                   VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                                                Value="{Binding Metallic, Mode=TwoWay}"
                                                                MinHeight="18" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Metallic, StringFormat={}{0:0.00}}"
                                                                   Classes="muted" FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>

                                                    <Grid ColumnDefinitions="60,*,40" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Emissive"
                                                                   Classes="muted" FontSize="11"
                                                                   VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="8"
                                                                Value="{Binding EmissiveStrength, Mode=TwoWay}"
                                                                MinHeight="18" />
                                                        <TextBlock Grid.Column="2" Text="{Binding EmissiveStrength, StringFormat={}{0:0.00}}"
                                                                   Classes="muted" FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>

                                                    <Grid ColumnDefinitions="60,*,40" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Opacity"
                                                                   Classes="muted" FontSize="11"
                                                                   VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                                                Value="{Binding Opacity, Mode=TwoWay}"
                                                                MinHeight="18" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:0.00}}"
                                                                   Classes="muted" FontSize="11"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Right" />
                                                    </Grid>

                                                    <CheckBox Content="Transparent"
                                                              IsChecked="{Binding IsTransparent, Mode=TwoWay}"
                                                              FontSize="11" />
                                                    <CheckBox Content="Cast Shadows" IsChecked="{Binding CastShadows, Mode=TwoWay}" IsVisible="{Binding !IsWater}" FontSize="11" />

                                                    <Expander Header="Textures" IsExpanded="True">
                                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                                            <TextBlock Text="Choose a texture or drag one from Assets." Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                                            <Grid ColumnDefinitions="60,*,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Tiling" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                                           ToolTip.Tip="How often the textures repeat across the mesh UVs (U, V)" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Minimum="0.01" Maximum="1000" Increment="1" Value="{Binding TilingU, Mode=TwoWay}" FormatString="0.##" />
                                                                <NumericUpDown Grid.Column="2" Classes="field" Minimum="0.01" Maximum="1000" Increment="1" Value="{Binding TilingV, Mode=TwoWay}" FormatString="0.##" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding TextureSlots}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="m:MaterialTextureSlotViewModel" x:DataType="m:MaterialTextureSlotViewModel">
                                                                        <StackPanel Spacing="4" Margin="0,0,0,8">
                                                                            <TextBlock Text="{Binding Name}" Classes="muted" FontSize="11" />
                                                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                                                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="MaterialTexture_Browse"
                                                                                        DragDrop.AllowDrop="True" DragDrop.DragOver="MaterialTexture_DragOver" DragDrop.Drop="MaterialTexture_Drop"
                                                                                        ToolTip.Tip="{Binding Label}">
                                                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="11" />
                                                                                </Button>
                                                                                <Button Grid.Column="1" Content="Clear" Command="{Binding ClearCommand}" ToolTip.Tip="Remove this texture map" />
                                                                                <Button Grid.Column="2" Content="Reset" Command="{Binding ResetCommand}" ToolTip.Tip="Use the model's texture map" />
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander Header="Shader" IsExpanded="True">
                                                        <StackPanel Spacing="8" Margin="0,8,0,0">
                                                            <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Shader"
                                                                           Classes="muted" FontSize="11"
                                                                           VerticalAlignment="Center" />
                                                                <ComboBox Grid.Column="1" Classes="field"
                                                                          HorizontalAlignment="Stretch"
                                                                          SelectedIndex="{Binding MaterialType, Mode=TwoWay}">
                                                                    <ComboBoxItem>Basic</ComboBoxItem>
                                                                    <ComboBoxItem>Hologram</ComboBoxItem>
                                                                    <ComboBoxItem>ProjectHologram</ComboBoxItem>
                                                                    <ComboBoxItem>Emissive</ComboBoxItem>
                                                                    <ComboBoxItem>SubsurfaceScattering</ComboBoxItem>
                                                                    <ComboBoxItem>ForwardShaded</ComboBoxItem>
                                                                    <ComboBoxItem>Water</ComboBoxItem>
                                                                    <ComboBoxItem>WetSurface</ComboBoxItem>
                                                                    <ComboBoxItem>Foliage</ComboBoxItem>
                                                                </ComboBox>
                                                            </Grid>
                                                            <Button Content="Apply Water Example" Command="{Binding WaterExampleCommand}" HorizontalAlignment="Stretch" />
                                                            <Button Content="Apply Wet Floor Example" Command="{Binding WetFloorExampleCommand}" HorizontalAlignment="Stretch" />
                                                            <StackPanel Spacing="8" IsVisible="{Binding IsWetSurface}">
                                                                <TextBlock Text="Wetness (dry weather)" Classes="muted" FontSize="11" />
                                                                <Slider Minimum="0" Maximum="1" Value="{Binding Wetness, Mode=TwoWay}" />
                                                                <TextBlock Text="Puddle Amount" Classes="muted" FontSize="11" />
                                                                <Slider Minimum="0" Maximum="1" Value="{Binding PuddleAmount, Mode=TwoWay}" />
                                                                <TextBlock Text="Puddle Size (m)" Classes="muted" FontSize="11" />
                                                                <NumericUpDown Classes="field" Minimum="0.1" Maximum="50" Increment="0.5" Value="{Binding PuddleSize, Mode=TwoWay}" FormatString="0.0" />
                                                                <CheckBox Content="Wet in Rain" IsChecked="{Binding WeatherWetness, Mode=TwoWay}" FontSize="11"
                                                                          ToolTip.Tip="Rain soaks the surface beyond Wetness, fills its puddles and ripples them; it dries after the rain" />
                                                                <TextBlock Text="Darkens and glosses the surface and pools mirror-like puddles on faces that look up. Puddles fill the dark parts of the Base Color first, or the low parts of the Displacement texture when one is set (used as height, no parallax). Puddle placement is world space, so it does not repeat with Tiling." Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <StackPanel Spacing="8" IsVisible="{Binding IsWater}">
                                                                <TextBlock Text="Wave Scale" Classes="muted" FontSize="11" />
                                                                <NumericUpDown Classes="field" Minimum="0.001" Maximum="10" Increment="0.05" Value="{Binding WaveScale, Mode=TwoWay}" FormatString="0.000" />
                                                                <TextBlock Text="Wave Speed" Classes="muted" FontSize="11" />
                                                                <NumericUpDown Classes="field" Minimum="0" Maximum="10" Increment="0.1" Value="{Binding WaveSpeed, Mode=TwoWay}" FormatString="0.00" />
                                                                <TextBlock Text="Wave Height (swell, m)" Classes="muted" FontSize="11" />
                                                                <NumericUpDown Classes="field" Minimum="0" Maximum="10" Increment="0.1" Value="{Binding WaveHeight, Mode=TwoWay}" FormatString="0.00" />
                                                                <TextBlock Text="Ripple Strength" Classes="muted" FontSize="11" />
                                                                <Slider Minimum="0" Maximum="2" Value="{Binding WaveStrength, Mode=TwoWay}" />
                                                                <TextBlock Text="Clarity (visible depth, m)" Classes="muted" FontSize="11" />
                                                                <NumericUpDown Classes="field" Minimum="0.05" Maximum="50" Increment="0.5" Value="{Binding Clarity, Mode=TwoWay}" FormatString="0.00" />
                                                                <TextBlock Text="Foam" Classes="muted" FontSize="11" />
                                                                <Slider Minimum="0" Maximum="1" Value="{Binding Foam, Mode=TwoWay}" />
                                                                <TextBlock Text="Apply to a flat mesh on the XY plane; it is subdivided so the swell moves the surface. Waves animate in Edit and Play mode; shore foam and depth colour appear where geometry sits below or through the surface. Give the gameobject the Water role to float Buoyancy bodies on it." Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Expander>
                                                    <Button Content="Remove Component" Command="{Binding RemoveCommand}" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                        <DataTemplate DataType="m:PhysicsComponentViewModel" x:DataType="m:PhysicsComponentViewModel">
                                            <Expander IsExpanded="True">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:LucideIcon Icon="Atom" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Spacing="8" Margin="12,8,12,12">
                                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" FontSize="11" />
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Body" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                  ItemsSource="{x:Static m:PhysicsComponentViewModel.BodyTypes}"
                                                                  SelectedItem="{Binding BodyType, Mode=TwoWay}" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8" IsVisible="{Binding IsDynamic}">
                                                        <TextBlock Grid.Column="0" Text="Mass" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Mass, Mode=TwoWay}"
                                                                       Minimum="0.001" ShowButtonSpinner="False" FormatString="0.###" />
                                                    </Grid>
                                                    <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding IsStatic}"
                                                               Text="Immovable mesh collider. Other bodies collide with it." />
                                                    <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding IsDynamic}"
                                                               Text="Falls with gravity and collides (convex hull). Simulated in Play mode." />
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Size" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <Grid Grid.Column="1" ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                                            <NumericUpDown Grid.Column="0" Classes="field" Value="{Binding ColliderSizeX, Mode=TwoWay}"
                                                                           ShowButtonSpinner="False" FormatString="0.###" ToolTip.Tip="X" />
                                                            <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding ColliderSizeY, Mode=TwoWay}"
                                                                           ShowButtonSpinner="False" FormatString="0.###" ToolTip.Tip="Y" />
                                                            <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding ColliderSizeZ, Mode=TwoWay}"
                                                                           ShowButtonSpinner="False" FormatString="0.###" ToolTip.Tip="Z" />
                                                        </Grid>
                                                    </Grid>
                                                    <Button Content="Default Size" Command="{Binding ResetColliderSizeCommand}" HorizontalAlignment="Stretch" />
                                                    <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                               Text="Collider box in model units (before Scale), shown in green on the selected gameobject. The collider shape is stretched to fill it; Default Size fits it to the model again." />
                                                    <CheckBox Content="Is Trigger" IsChecked="{Binding IsTrigger, Mode=TwoWay}" FontSize="11" />
                                                    <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding IsTrigger}"
                                                               Text="Overlaps instead of colliding: scripts get OnTriggerEnter/Stay/Exit, nothing is pushed and raycasts pass through. A Static trigger is the model's convex hull." />
                                                    <CheckBox Content="Freeze Rotation" IsChecked="{Binding FreezeRotation, Mode=TwoWay}" FontSize="11" IsVisible="{Binding IsDynamic}" />
                                                    <CheckBox Content="Buoyancy" IsChecked="{Binding Buoyancy, Mode=TwoWay}" FontSize="11" IsVisible="{Binding IsDynamic}" />
                                                    <StackPanel Spacing="8" IsVisible="{Binding IsDynamic}">
                                                        <StackPanel Spacing="8" IsVisible="{Binding Buoyancy}">
                                                            <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Float" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding BuoyancyStrength, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="20" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Drag" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding WaterDrag, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="20" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                            <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                                       Text="Floats in gameobjects with the Water role. Float is the push when fully under water relative to weight: 2 floats half-submerged, below 1 sinks. Drag slows motion and spin in water." />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Content="Remove Component" Command="{Binding RemoveCommand}" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                        <DataTemplate DataType="m:AnimatorComponentViewModel" x:DataType="m:AnimatorComponentViewModel">
                                            <Expander IsExpanded="True">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:LucideIcon Icon="PersonStanding" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Spacing="8" Margin="12,8,12,12">
                                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" FontSize="11" />
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Source" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Classes="field" Text="{Binding ClipSource, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 PlaceholderText="This model" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Clip" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Classes="field" Text="{Binding ClipName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 PlaceholderText="Longest clip" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Speed" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Speed, Mode=TwoWay}"
                                                                       Minimum="-10" Maximum="10" Increment="0.1" FormatString="0.##" />
                                                    </Grid>
                                                    <CheckBox Content="Loop" IsChecked="{Binding Loop, Mode=TwoWay}" FontSize="11" />
                                                    <CheckBox Content="In Place" IsChecked="{Binding InPlace, Mode=TwoWay}" FontSize="11" />
                                                    <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                               Text="Plays a skeletal clip in Play mode (the bind pose shows while editing). Source is the content path of another skinned model with the same bone names, e.g. GameObjects/Player/Walking; empty uses this model's own clips. In Place removes the clip's forward travel." />
                                                    <Button Content="Remove Component" Command="{Binding RemoveCommand}" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                        <DataTemplate DataType="m:RagdollComponentViewModel" x:DataType="m:RagdollComponentViewModel">
                                            <Expander IsExpanded="True">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:LucideIcon Icon="Bone" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Spacing="8" Margin="12,8,12,12">
                                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" FontSize="11" />
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Mass" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Mass, Mode=TwoWay}"
                                                                       Minimum="1" Maximum="10000" Increment="5" FormatString="0.#" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Impact" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding ImpactThreshold, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="100" Increment="0.5" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Friction" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding JointFriction, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" />
                                                    </Grid>
                                                    <CheckBox Content="Active on Start" IsChecked="{Binding ActiveOnStart, Mode=TwoWay}" FontSize="11" />
                                                    <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                               Text="Rigid bodies for the bones of a skinned model. In Play they follow the animation (other bodies bounce off them) until the ragdoll goes limp: on start, when a body hits it faster than Impact m/s (0 = never), or from a script (GetComponent&lt;RagdollComponent&gt;().Activate()). Mass is the whole body's, in kg; Friction stiffens the joints." />
                                                    <Button Content="Remove Component" Command="{Binding RemoveCommand}" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                        <DataTemplate DataType="m:FogVolumeComponentViewModel" x:DataType="m:FogVolumeComponentViewModel">
                                            <Expander IsExpanded="True">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:LucideIcon Icon="CloudFog" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Spacing="8" Margin="12,8,12,12">
                                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" FontSize="11" />
                                                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Density" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Density, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="5" Increment="0.01" FormatString="0.###" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="70,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Edge Fade" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding EdgeFade, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" />
                                                    </Grid>
                                                    <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                               Text="Adds fog inside a box: this gameobject's position, rotation and scale (like a Cube). It ignores the scene fog's distance ramp, so a dusty room shows light shafts up close. The mesh is hidden while enabled; select it in the hierarchy. Density uses the scene fog's units (Environment > Volumetric Fog, default 0.03). At most 8 volumes draw." />
                                                    <Button Content="Remove Component" Command="{Binding RemoveCommand}" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                        <DataTemplate DataType="m:FoliageWindComponentViewModel" x:DataType="m:FoliageWindComponentViewModel">
                                            <Expander IsExpanded="True">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:LucideIcon Icon="TreeDeciduous" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Spacing="8" Margin="12,8,12,12">
                                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" FontSize="11" />
                                                    <Grid ColumnDefinitions="80,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Trunk Bend" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding TrunkBend, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="3" Increment="0.1" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="80,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Branch Sway" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding BranchSway, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="3" Increment="0.1" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="80,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Leaf Flutter" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding LeafFlutter, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="3" Increment="0.1" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="80,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Wind Scale" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding WindScale, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="5" Increment="0.1" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="80,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Min Wind m/s" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding MinWind, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="40" Increment="0.5" FormatString="0.#" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="80,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Speed" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Speed, Mode=TwoWay}"
                                                                       Minimum="0.05" Maximum="5" Increment="0.1" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="80,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Height m" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Height, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="1000" Increment="0.5" FormatString="0.##" />
                                                    </Grid>
                                                    <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                               Text="Sways the gameobject in the scene wind (Environment > Wind Speed / Direction), in the editor too: the trunk bends with gusts, branches bob and leaves flutter. Only materials with Shader Foliage flutter (the Tree model's leaves). Height 0 = the model's height; the model's base must be at its origin, Z up. Visual only: colliders stay still." />
                                                    <Button Content="Remove Component" Command="{Binding RemoveCommand}" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                        <DataTemplate DataType="m:InteractableComponentViewModel" x:DataType="m:InteractableComponentViewModel">
                                            <Expander IsExpanded="True">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:LucideIcon Icon="Hand" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Spacing="8" Margin="12,8,12,12">
                                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" FontSize="11" />
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Prompt" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Classes="field" Text="{Binding Prompt, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 PlaceholderText="Interact" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Range" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Range, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="1000" Increment="0.5" FormatString="0.##" />
                                                    </Grid>
                                                    <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                               Text="Scripts aim at it with FindInteractable(CameraRay, ...) and use it with Interact(hit), which runs OnInteract on this gameobject's scripts. Rays only hit colliders, so add a Physics component too. Range is in metres from the camera." />
                                                    <Button Content="Remove Component" Command="{Binding RemoveCommand}" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                        <DataTemplate DataType="m:ClothComponentViewModel" x:DataType="m:ClothComponentViewModel">
                                            <Expander IsExpanded="True">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:LucideIcon Icon="Flag" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Spacing="8" Margin="12,8,12,12">
                                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" FontSize="11" />
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Pin" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                  ItemsSource="{x:Static m:ClothComponentViewModel.PinModes}"
                                                                  SelectedItem="{Binding Pin, Mode=TwoWay}" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Mass" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Mass, Mode=TwoWay}"
                                                                       Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Stiffness" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Stiffness, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Bend" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Bend, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Damping" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Damping, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Friction" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Friction, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="2" Increment="0.05" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Thickness" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Thickness, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="0.5" Increment="0.01" FormatString="0.###" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Wind" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Wind, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="10" Increment="0.1" FormatString="0.##" />
                                                    </Grid>
                                                    <CheckBox Content="Collisions" IsChecked="{Binding Collisions, Mode=TwoWay}" FontSize="11" />
                                                    <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                               Text="Simulates this mesh as cloth in Play (use the Cloth model: a subdivided double-sided plane). Pin holds the top row (model Z), its two ends or the outline in place, following the gameobject. With Collisions it stays out of every Physics collider around it, bodies push it but it doesn't push back. Stiffness keeps its size, Bend resists folding, Thickness is the gap it keeps (m), Wind scales the scene's wind." />
                                                    <Button Content="Remove Component" Command="{Binding RemoveCommand}" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                        <DataTemplate DataType="m:NpcComponentViewModel" x:DataType="m:NpcComponentViewModel">
                                            <Expander IsExpanded="True">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:LucideIcon Icon="Footprints" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Spacing="8" Margin="12,8,12,12">
                                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" FontSize="11" />
                                                    <TextBlock Text="MOVEMENT" Classes="muted" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Walk Speed" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding WalkSpeed, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="50" Increment="0.5" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Run Speed" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding RunSpeed, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="50" Increment="0.5" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" ToolTip.Tip="Degrees per second.">
                                                        <TextBlock Grid.Column="0" Text="Turn Speed" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding TurnSpeed, Mode=TwoWay}"
                                                                       Minimum="1" Maximum="3600" Increment="30" FormatString="0" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" ToolTip.Tip="Largest change of speed per second (m/s²).">
                                                        <TextBlock Grid.Column="0" Text="Acceleration" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Acceleration, Mode=TwoWay}"
                                                                       Minimum="0.1" Maximum="500" Increment="1" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" ToolTip.Tip="Clearance kept from walls on paths (m); 0 uses the collider's half width.">
                                                        <TextBlock Grid.Column="0" Text="Radius" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Radius, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="3" Increment="0.05" FormatString="0.##" />
                                                    </Grid>
                                                    <TextBlock Text="IDLE" Classes="muted" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Behaviour" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                  ItemsSource="{x:Static m:NpcComponentViewModel.IdleBehaviours}"
                                                                  SelectedItem="{Binding Idle, Mode=TwoWay}" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" IsVisible="{Binding IsWander}">
                                                        <TextBlock Grid.Column="0" Text="Wander Radius" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding WanderRadius, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="500" Increment="0.5" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" IsVisible="{Binding IsPatrol}" ToolTip.Tip="Names of the gameobjects to walk between, separated by commas, in order (a loop).">
                                                        <TextBlock Grid.Column="0" Text="Patrol Points" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Classes="field" Text="{Binding PatrolPoints, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 PlaceholderText="Post 1, Post 2, Post 3" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" ToolTip.Tip="Seconds spent at each wander or patrol point.">
                                                        <TextBlock Grid.Column="0" Text="Wait Time" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding WaitTime, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="120" Increment="0.25" FormatString="0.##" />
                                                    </Grid>
                                                    <TextBlock Text="PERCEPTION" Classes="muted" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" ToolTip.Tip="Name of the gameobject it watches for.">
                                                        <TextBlock Grid.Column="0" Text="Target" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBox Grid.Column="1" Classes="field" Text="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                 PlaceholderText="Player" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="Sight Range" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding SightRange, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="500" Increment="0.5" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" ToolTip.Tip="Width of the view cone in degrees, around its +Y.">
                                                        <TextBlock Grid.Column="0" Text="Field of View" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding FieldOfView, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="360" Increment="5" FormatString="0" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" ToolTip.Tip="Notices the target in any direction this close (still not through walls).">
                                                        <TextBlock Grid.Column="0" Text="Hearing Range" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding HearingRange, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="500" Increment="0.25" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" ToolTip.Tip="Above the gameobject's origin; sight rays start here.">
                                                        <TextBlock Grid.Column="0" Text="Eye Height" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding EyeHeight, Mode=TwoWay}"
                                                                       Minimum="-100" Maximum="100" Increment="0.05" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" ToolTip.Tip="Seconds between noticing the target and reacting.">
                                                        <TextBlock Grid.Column="0" Text="Reaction Time" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding ReactionTime, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="10" Increment="0.05" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" ToolTip.Tip="Seconds it keeps going after losing sight of the target.">
                                                        <TextBlock Grid.Column="0" Text="Memory Time" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding MemoryTime, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="60" Increment="0.5" FormatString="0.##" />
                                                    </Grid>
                                                    <TextBlock Text="REACTION" Classes="muted" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8">
                                                        <TextBlock Grid.Column="0" Text="On Sight" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                  ItemsSource="{x:Static m:NpcComponentViewModel.Reactions}"
                                                                  SelectedItem="{Binding Reaction, Mode=TwoWay}" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" IsVisible="{Binding IsChase}">
                                                        <TextBlock Grid.Column="0" Text="Attack Range" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding AttackRange, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="50" Increment="0.1" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" IsVisible="{Binding IsChase}">
                                                        <TextBlock Grid.Column="0" Text="Attack Cooldown" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding AttackCooldown, Mode=TwoWay}"
                                                                       Minimum="0.05" Maximum="30" Increment="0.1" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" IsVisible="{Binding IsChase}" ToolTip.Tip="Impulse given to the target's Dynamic body (N·s).">
                                                        <TextBlock Grid.Column="0" Text="Attack Force" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding AttackForce, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="100000" Increment="25" FormatString="0" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" IsVisible="{Binding IsFollow}">
                                                        <TextBlock Grid.Column="0" Text="Follow Distance" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding FollowDistance, Mode=TwoWay}"
                                                                       Minimum="0.5" Maximum="100" Increment="0.25" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" IsVisible="{Binding IsFlee}">
                                                        <TextBlock Grid.Column="0" Text="Flee Distance" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding FleeDistance, Mode=TwoWay}"
                                                                       Minimum="1" Maximum="200" Increment="0.5" FormatString="0.##" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" IsVisible="{Binding SearchesAfterLosing}" ToolTip.Tip="Seconds spent looking around where the target was lost.">
                                                        <TextBlock Grid.Column="0" Text="Search Time" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding SearchTime, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="60" Increment="0.5" FormatString="0.##" />
                                                    </Grid>
                                                    <CheckBox Content="Show Debug (path, view cone)" IsChecked="{Binding ShowDebug, Mode=TwoWay}" FontSize="11" />
                                                    <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                               Text="A computer-controlled character for Play. It walks a navigation grid built from the scene's Static colliders (A* around walls, up ramps, never off ledges), idles (stand, wander or patrol), and watches for its Target with a view cone and line-of-sight rays. On sight: Chase runs after it and shoves it within Attack Range, Follow keeps Follow Distance, Flee runs away, Watch turns to face it. Use a Dynamic capsule with Freeze Rotation; its +Y is its forward. Its scripts get OnTargetSpotted, OnTargetLost, OnNpcStateChanged and OnNpcAttack." />
                                                    <Button Content="Remove Component" Command="{Binding RemoveCommand}" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                        <DataTemplate DataType="m:LodComponentViewModel" x:DataType="m:LodComponentViewModel">
                                            <Expander IsExpanded="True">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:LucideIcon Icon="Layers" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Spacing="8" Margin="12,8,12,12">
                                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" FontSize="11" />
                                                    <Grid ColumnDefinitions="*,80,Auto" ColumnSpacing="4">
                                                        <TextBlock Grid.Column="0" Text="Model" Classes="muted" FontSize="11" />
                                                        <TextBlock Grid.Column="1" Text="From (m)" Classes="muted" FontSize="11" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Levels}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="m:LodLevelViewModel" x:DataType="m:LodLevelViewModel">
                                                                <Grid ColumnDefinitions="*,80,Auto" ColumnSpacing="4" Margin="0,0,0,4">
                                                                    <ComboBox Grid.Column="0" Classes="field" HorizontalAlignment="Stretch"
                                                                              ItemsSource="{Binding ModelKeys}" SelectedItem="{Binding Model, Mode=TwoWay}"
                                                                              PlaceholderText="Pick a model" ToolTip.Tip="Model drawn from this distance on" />
                                                                    <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Distance, Mode=TwoWay}"
                                                                                   Minimum="0.1" Maximum="100000" Increment="5" FormatString="0.#"
                                                                                   ToolTip.Tip="Camera distance (metres) from which this model draws" />
                                                                    <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this level" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button Content="Add Level" Command="{Binding AddLevelCommand}" HorizontalAlignment="Stretch" />
                                                    <Grid ColumnDefinitions="92,*" ColumnSpacing="8" ToolTip.Tip="Nothing draws from this camera distance on; 0 never culls.">
                                                        <TextBlock Grid.Column="0" Text="Cull Distance" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding CullDistance, Mode=TwoWay}"
                                                                       Minimum="0" Maximum="100000" Increment="10" FormatString="0.#" />
                                                    </Grid>
                                                    <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                               Text="Level of detail: up close the gameobject draws its own model; from each level's distance on (camera to the centre of its bounds) it draws that level's simpler model instead, and from Cull Distance nothing. Works in the editor and in Play, shadows included; physics and picking bounds keep the gameobject's own model. LOD models draw unposed, so animated gameobjects should only use Cull Distance." />
                                                    <Button Content="Remove Component" Command="{Binding RemoveCommand}" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                        <DataTemplate DataType="m:ParticleSystemComponentViewModel" x:DataType="m:ParticleSystemComponentViewModel">
                                            <Expander IsExpanded="True">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:LucideIcon Icon="Sparkles" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Spacing="6" Margin="12,8,12,12">
                                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" FontSize="11" />
                                                    <CheckBox Content="Hide Mesh in Play" IsChecked="{Binding HideMesh, Mode=TwoWay}" FontSize="11" ToolTip.Tip="The gameobject's mesh marks the emitter while editing and is hidden in Play" />
                                                    <Expander IsExpanded="True" Header="Main">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Seconds of one emission cycle; bursts are timed within it">
                                                                <TextBlock Grid.Column="0" Text="Duration" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Duration, Mode=TwoWay}"
                                                                               Minimum="0.05" Maximum="3600" Increment="0.5" FormatString="0.##" />
                                                            </Grid>
                                                            <CheckBox Content="Looping" IsChecked="{Binding Looping, Mode=TwoWay}" FontSize="11" />
                                                            <CheckBox Content="Prewarm" IsChecked="{Binding Prewarm, Mode=TwoWay}" FontSize="11" ToolTip.Tip="Looping systems start as if a whole cycle had already run" />
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Seconds before the first emission">
                                                                <TextBlock Grid.Column="0" Text="Start Delay" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding StartDelay, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="3600" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*,*" ColumnSpacing="4" ToolTip.Tip="Seconds each particle lives (random between the two)">
                                                                <TextBlock Grid.Column="0" Text="Start Lifetime" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding StartLifetimeMin, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="0.01" Maximum="3600" Increment="0.5" FormatString="0.##" ToolTip.Tip="Min" />
                                                                <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding StartLifetimeMax, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="0.01" Maximum="3600" Increment="0.5" FormatString="0.##" ToolTip.Tip="Max" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*,*" ColumnSpacing="4" ToolTip.Tip="Metres per second along the shape's direction">
                                                                <TextBlock Grid.Column="0" Text="Start Speed" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding StartSpeedMin, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-10000" Maximum="10000" Increment="0.5" FormatString="0.##" ToolTip.Tip="Min" />
                                                                <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding StartSpeedMax, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-10000" Maximum="10000" Increment="0.5" FormatString="0.##" ToolTip.Tip="Max" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*,*" ColumnSpacing="4" ToolTip.Tip="Metres across">
                                                                <TextBlock Grid.Column="0" Text="Start Size" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding StartSizeMin, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="0" Maximum="10000" Increment="0.1" FormatString="0.##" ToolTip.Tip="Min" />
                                                                <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding StartSizeMax, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="0" Maximum="10000" Increment="0.1" FormatString="0.##" ToolTip.Tip="Max" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*,*" ColumnSpacing="4" ToolTip.Tip="Degrees">
                                                                <TextBlock Grid.Column="0" Text="Start Rotation" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding StartRotationMin, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-36000" Maximum="36000" Increment="15" FormatString="0" ToolTip.Tip="Min" />
                                                                <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding StartRotationMax, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-36000" Maximum="36000" Increment="15" FormatString="0" ToolTip.Tip="Max" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Each particle picks a colour between Start Color and Color 2 (alpha = opacity)">
                                                                <TextBlock Grid.Column="0" Text="Start Color" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                                                                    <Border Width="44" Height="18" CornerRadius="3"
                                                                            Background="{Binding StartColor, Converter={StaticResource ColorToBrush}}"
                                                                            BorderBrush="{StaticResource AnvilBorderBrush}" BorderThickness="1" />
                                                                    <Button.Flyout>
                                                                        <!-- OwnedFlyout_Opening pins the picker to this field. -->
                                                                        <Flyout Opening="OwnedFlyout_Opening">
                                                                            <ColorPicker x:DataType="m:ParticleSystemComponentViewModel" Color="{Binding StartColor, Mode=TwoWay}" />
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Color 2" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                                                                    <Border Width="44" Height="18" CornerRadius="3"
                                                                            Background="{Binding StartColor2, Converter={StaticResource ColorToBrush}}"
                                                                            BorderBrush="{StaticResource AnvilBorderBrush}" BorderThickness="1" />
                                                                    <Button.Flyout>
                                                                        <!-- OwnedFlyout_Opening pins the picker to this field. -->
                                                                        <Flyout Opening="OwnedFlyout_Opening">
                                                                            <ColorPicker x:DataType="m:ParticleSystemComponentViewModel" Color="{Binding StartColor2, Mode=TwoWay}" />
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Share of the scene's gravity; negative rises">
                                                                <TextBlock Grid.Column="0" Text="Gravity" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding GravityModifier, Mode=TwoWay}"
                                                                               Minimum="-100" Maximum="100" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Local particles move with the gameobject, World ones stay where they were born">
                                                                <TextBlock Grid.Column="0" Text="Space" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{x:Static m:ParticleSystemComponentViewModel.SimulationSpaces}"
                                                                          SelectedItem="{Binding SimulationSpace, Mode=TwoWay}" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Sim Speed" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding SimulationSpeed, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                            <CheckBox Content="Play On Awake" IsChecked="{Binding PlayOnAwake, Mode=TwoWay}" FontSize="11" ToolTip.Tip="Plays with Play and in the editor; otherwise scripts or sub-emitters start it" />
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Max Particles" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding MaxParticles, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="100000" Increment="100" FormatString="0" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="True" Header="Emission">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <CheckBox Content="Enabled" IsChecked="{Binding EmissionEnabled, Mode=TwoWay}" FontSize="11" />
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Rate / Second" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding RateOverTime, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="100000" Increment="1" FormatString="0.#" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Particles per metre the gameobject moves">
                                                                <TextBlock Grid.Column="0" Text="Rate / Metre" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding RateOverDistance, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="100000" Increment="1" FormatString="0.#" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="*,*,*,*,*,Auto" ColumnSpacing="4">
                                                                <TextBlock Grid.Column="0" Text="Time" Classes="muted" FontSize="10" />
                                                                <TextBlock Grid.Column="1" Text="Min" Classes="muted" FontSize="10" />
                                                                <TextBlock Grid.Column="2" Text="Max" Classes="muted" FontSize="10" />
                                                                <TextBlock Grid.Column="3" Text="Cycles" Classes="muted" FontSize="10" />
                                                                <TextBlock Grid.Column="4" Text="Interval" Classes="muted" FontSize="10" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Bursts}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="m:ParticleBurstRowViewModel" x:DataType="m:ParticleBurstRowViewModel">
                                                                        <Grid ColumnDefinitions="*,*,*,*,*,Auto" ColumnSpacing="4" Margin="0,0,0,4">
                                                                            <NumericUpDown Grid.Column="0" Classes="field" Value="{Binding Time, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                           Minimum="0" Maximum="3600" Increment="0.1" FormatString="0.##" ToolTip.Tip="Seconds into the cycle" />
                                                                            <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding CountMin, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                           Minimum="0" Maximum="100000" Increment="1" FormatString="0" ToolTip.Tip="Particles (min)" />
                                                                            <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding CountMax, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                           Minimum="0" Maximum="100000" Increment="1" FormatString="0" ToolTip.Tip="Particles (max)" />
                                                                            <NumericUpDown Grid.Column="3" Classes="field" Value="{Binding Cycles, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                           Minimum="0" Maximum="10000" Increment="1" FormatString="0" ToolTip.Tip="Repeats per cycle; 0 = until the cycle ends" />
                                                                            <NumericUpDown Grid.Column="4" Classes="field" Value="{Binding Interval, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                           Minimum="0.01" Maximum="3600" Increment="0.05" FormatString="0.##" ToolTip.Tip="Seconds between repeats" />
                                                                            <Button Grid.Column="5" Content="Remove" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this row" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Content="Add Burst" Command="{Binding AddBurstCommand}" HorizontalAlignment="Stretch" />
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="True" Header="Shape">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <CheckBox Content="Enabled" IsChecked="{Binding ShapeEnabled, Mode=TwoWay}" FontSize="11" />
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Shape" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{x:Static m:ParticleSystemComponentViewModel.ShapeTypes}"
                                                                          SelectedItem="{Binding ShapeType, Mode=TwoWay}" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Cone opening in degrees">
                                                                <TextBlock Grid.Column="0" Text="Angle" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Angle, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="90" Increment="5" FormatString="0.#" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Radius" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Radius, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="10000" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="1 emits from the whole volume, 0 from the surface/rim">
                                                                <TextBlock Grid.Column="0" Text="Thickness" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding RadiusThickness, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="1" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Degrees of the circle used">
                                                                <TextBlock Grid.Column="0" Text="Arc" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Arc, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="360" Increment="15" FormatString="0" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*,*,*" ColumnSpacing="4">
                                                                <TextBlock Grid.Column="0" Text="Box Size" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding BoxX, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="0" Maximum="100000" FormatString="0.##" ToolTip.Tip="X" />
                                                                <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding BoxY, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="0" Maximum="100000" FormatString="0.##" ToolTip.Tip="Y" />
                                                                <NumericUpDown Grid.Column="3" Classes="field" Value="{Binding BoxZ, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="0" Maximum="100000" FormatString="0.##" ToolTip.Tip="Z" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*,*,*" ColumnSpacing="4" ToolTip.Tip="Shape offset (local metres)">
                                                                <TextBlock Grid.Column="0" Text="Position" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding ShapePositionX, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-100000" Maximum="100000" FormatString="0.##" ToolTip.Tip="X" />
                                                                <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding ShapePositionY, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-100000" Maximum="100000" FormatString="0.##" ToolTip.Tip="Y" />
                                                                <NumericUpDown Grid.Column="3" Classes="field" Value="{Binding ShapePositionZ, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-100000" Maximum="100000" FormatString="0.##" ToolTip.Tip="Z" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*,*,*" ColumnSpacing="4" ToolTip.Tip="Shape rotation (local degrees)">
                                                                <TextBlock Grid.Column="0" Text="Rotation" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding ShapeRotationX, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-100000" Maximum="100000" FormatString="0.##" ToolTip.Tip="X" />
                                                                <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding ShapeRotationY, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-100000" Maximum="100000" FormatString="0.##" ToolTip.Tip="Y" />
                                                                <NumericUpDown Grid.Column="3" Classes="field" Value="{Binding ShapeRotationZ, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-100000" Maximum="100000" FormatString="0.##" ToolTip.Tip="Z" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Blends each direction towards a random one">
                                                                <TextBlock Grid.Column="0" Text="Randomize" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding RandomizeDirection, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="1" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                            <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                                       Text="Local axes, Z up: Cone, Box and Edge emit along +Z, Circle and Sphere outwards. The gameobject's rotation turns the shape; its scale is ignored." />
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="False" Header="Velocity over Lifetime">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <CheckBox Content="Enabled" IsChecked="{Binding VelocityEnabled, Mode=TwoWay}" FontSize="11" />
                                                            <Grid ColumnDefinitions="96,*,*,*" ColumnSpacing="4" ToolTip.Tip="Metres per second added every frame">
                                                                <TextBlock Grid.Column="0" Text="Linear" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding LinearX, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-100000" Maximum="100000" FormatString="0.##" ToolTip.Tip="X" />
                                                                <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding LinearY, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-100000" Maximum="100000" FormatString="0.##" ToolTip.Tip="Y" />
                                                                <NumericUpDown Grid.Column="3" Classes="field" Value="{Binding LinearZ, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-100000" Maximum="100000" FormatString="0.##" ToolTip.Tip="Z" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Space" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{x:Static m:ParticleSystemComponentViewModel.SimulationSpaces}"
                                                                          SelectedItem="{Binding VelocitySpace, Mode=TwoWay}" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*,*,*" ColumnSpacing="4" ToolTip.Tip="Degrees per second around the gameobject's local axes">
                                                                <TextBlock Grid.Column="0" Text="Orbital" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding OrbitalX, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-100000" Maximum="100000" FormatString="0.##" ToolTip.Tip="X" />
                                                                <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding OrbitalY, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-100000" Maximum="100000" FormatString="0.##" ToolTip.Tip="Y" />
                                                                <NumericUpDown Grid.Column="3" Classes="field" Value="{Binding OrbitalZ, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-100000" Maximum="100000" FormatString="0.##" ToolTip.Tip="Z" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Metres per second away from the gameobject">
                                                                <TextBlock Grid.Column="0" Text="Radial" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Radial, Mode=TwoWay}"
                                                                               Minimum="-1000" Maximum="1000" Increment="0.5" FormatString="0.##" />
                                                            </Grid>
                                                            <TextBlock Text="Speed Modifier (multiplies own velocity)" Classes="muted" FontSize="11" />
                                                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="4">
                                                                <TextBlock Grid.Column="0" Text="Time" Classes="muted" FontSize="10" />
                                                                <TextBlock Grid.Column="1" Text="Value" Classes="muted" FontSize="10" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding SpeedKeys}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="m:ParticleCurveKeyRowViewModel" x:DataType="m:ParticleCurveKeyRowViewModel">
                                                                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="4" Margin="0,0,0,4">
                                                                            <NumericUpDown Grid.Column="0" Classes="field" Value="{Binding Time, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" ToolTip.Tip="Share of the lifetime, 0..1" />
                                                                            <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Value, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                           Minimum="-1000" Maximum="1000" Increment="0.1" FormatString="0.##" ToolTip.Tip="Multiplier" />
                                                                            <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this row" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Content="Add Key" Command="{Binding AddSpeedKeyCommand}" HorizontalAlignment="Stretch" />
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="False" Header="Limit Velocity">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <CheckBox Content="Enabled" IsChecked="{Binding LimitEnabled, Mode=TwoWay}" FontSize="11" />
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Above this (m/s) particles slow down; 0 = no limit">
                                                                <TextBlock Grid.Column="0" Text="Speed" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding LimitSpeed, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="100000" Increment="0.5" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Share of the excess speed removed">
                                                                <TextBlock Grid.Column="0" Text="Dampen" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding LimitDampen, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Air resistance per second">
                                                                <TextBlock Grid.Column="0" Text="Drag" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Drag, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="1000" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="False" Header="Force over Lifetime">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <CheckBox Content="Enabled" IsChecked="{Binding ForceEnabled, Mode=TwoWay}" FontSize="11" />
                                                            <Grid ColumnDefinitions="96,*,*,*" ColumnSpacing="4" ToolTip.Tip="Acceleration, m/s²">
                                                                <TextBlock Grid.Column="0" Text="Force" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding ForceX, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-100000" Maximum="100000" FormatString="0.##" ToolTip.Tip="X" />
                                                                <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding ForceY, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-100000" Maximum="100000" FormatString="0.##" ToolTip.Tip="Y" />
                                                                <NumericUpDown Grid.Column="3" Classes="field" Value="{Binding ForceZ, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-100000" Maximum="100000" FormatString="0.##" ToolTip.Tip="Z" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Space" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{x:Static m:ParticleSystemComponentViewModel.SimulationSpaces}"
                                                                          SelectedItem="{Binding ForceSpace, Mode=TwoWay}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="False" Header="External Forces">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <CheckBox Content="Enabled" IsChecked="{Binding ExternalEnabled, Mode=TwoWay}" FontSize="11" />
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Multiplies the scene's wind (Environment &gt; Wind)">
                                                                <TextBlock Grid.Column="0" Text="Wind" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Wind, Mode=TwoWay}"
                                                                               Minimum="-100" Maximum="100" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="How fast particles pick up the wind, per second">
                                                                <TextBlock Grid.Column="0" Text="Response" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding WindResponse, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="False" Header="Noise">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <CheckBox Content="Enabled" IsChecked="{Binding NoiseEnabled, Mode=TwoWay}" FontSize="11" />
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Metres per second of wander">
                                                                <TextBlock Grid.Column="0" Text="Strength" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding NoiseStrength, Mode=TwoWay}"
                                                                               Minimum="-1000" Maximum="1000" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Swirls per metre">
                                                                <TextBlock Grid.Column="0" Text="Frequency" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding NoiseFrequency, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Scroll Speed" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding NoiseScrollSpeed, Mode=TwoWay}"
                                                                               Minimum="-100" Maximum="100" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="False" Header="Color over Lifetime">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <CheckBox Content="Enabled" IsChecked="{Binding ColorEnabled, Mode=TwoWay}" FontSize="11" />
                                                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="4">
                                                                <TextBlock Grid.Column="0" Text="Time" Classes="muted" FontSize="10" />
                                                                <TextBlock Grid.Column="1" Text="Color" Classes="muted" FontSize="10" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding ColorKeys}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="m:ParticleGradientKeyRowViewModel" x:DataType="m:ParticleGradientKeyRowViewModel">
                                                                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="4" Margin="0,0,0,4">
                                                                            <NumericUpDown Grid.Column="0" Classes="field" Value="{Binding Time, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" ToolTip.Tip="Share of the lifetime, 0..1" />
                                                                            <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                                                                                <Border Width="44" Height="18" CornerRadius="3"
                                                                                        Background="{Binding Color, Converter={StaticResource ColorToBrush}}"
                                                                                        BorderBrush="{StaticResource AnvilBorderBrush}" BorderThickness="1" />
                                                                                <Button.Flyout>
                                                                                    <!-- OwnedFlyout_Opening pins the picker to this field. -->
                                                                                    <Flyout Opening="OwnedFlyout_Opening">
                                                                                        <ColorPicker x:DataType="m:ParticleGradientKeyRowViewModel" Color="{Binding Color, Mode=TwoWay}" />
                                                                                    </Flyout>
                                                                                </Button.Flyout>
                                                                            </Button>
                                                                            <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this row" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Content="Add Key" Command="{Binding AddColorKeyCommand}" HorizontalAlignment="Stretch" />
                                                            <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                                       Text="Multiplies the start colour; alpha fades. Keys blend in a straight line." />
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="False" Header="Size over Lifetime">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <CheckBox Content="Enabled" IsChecked="{Binding SizeEnabled, Mode=TwoWay}" FontSize="11" />
                                                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="4">
                                                                <TextBlock Grid.Column="0" Text="Time" Classes="muted" FontSize="10" />
                                                                <TextBlock Grid.Column="1" Text="Size" Classes="muted" FontSize="10" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding SizeKeys}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="m:ParticleCurveKeyRowViewModel" x:DataType="m:ParticleCurveKeyRowViewModel">
                                                                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="4" Margin="0,0,0,4">
                                                                            <NumericUpDown Grid.Column="0" Classes="field" Value="{Binding Time, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                           Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" ToolTip.Tip="Share of the lifetime, 0..1" />
                                                                            <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Value, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                           Minimum="-1000" Maximum="1000" Increment="0.1" FormatString="0.##" ToolTip.Tip="Multiplier" />
                                                                            <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this row" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Content="Add Key" Command="{Binding AddSizeKeyCommand}" HorizontalAlignment="Stretch" />
                                                            <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                                       Text="Multiplies the start size." />
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="False" Header="Rotation over Lifetime">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <CheckBox Content="Enabled" IsChecked="{Binding RotationEnabled, Mode=TwoWay}" FontSize="11" />
                                                            <Grid ColumnDefinitions="96,*,*" ColumnSpacing="4" ToolTip.Tip="Degrees per second">
                                                                <TextBlock Grid.Column="0" Text="Spin" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding AngularVelocityMin, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-36000" Maximum="36000" Increment="15" FormatString="0" ToolTip.Tip="Min" />
                                                                <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding AngularVelocityMax, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                               Minimum="-36000" Maximum="36000" Increment="15" FormatString="0" ToolTip.Tip="Max" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="False" Header="Collision">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <CheckBox Content="Enabled" IsChecked="{Binding CollisionEnabled, Mode=TwoWay}" FontSize="11" />
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Plane: a floor at a height. World: every Physics collider (a ray per particle)">
                                                                <TextBlock Grid.Column="0" Text="Type" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{x:Static m:ParticleSystemComponentViewModel.CollisionTypes}"
                                                                          SelectedItem="{Binding CollisionType, Mode=TwoWay}" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Plane only: world Z of the floor">
                                                                <TextBlock Grid.Column="0" Text="Plane Height" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding PlaneHeight, Mode=TwoWay}"
                                                                               Minimum="-100000" Maximum="100000" Increment="0.5" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Bounce" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Bounce, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="2" Increment="0.05" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Speed along the surface lost per hit">
                                                                <TextBlock Grid.Column="0" Text="Dampen" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding CollisionDampen, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Share of the lifetime each hit uses up (1 dies on contact)">
                                                                <TextBlock Grid.Column="0" Text="Lifetime Loss" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding LifetimeLoss, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Collision radius as a share of half the size">
                                                                <TextBlock Grid.Column="0" Text="Radius Scale" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding RadiusScale, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Slower than this after a hit, a particle dies">
                                                                <TextBlock Grid.Column="0" Text="Min Kill Speed" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding MinKillSpeed, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="100000" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="False" Header="Texture Sheet Animation">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <CheckBox Content="Enabled" IsChecked="{Binding SheetEnabled, Mode=TwoWay}" FontSize="11" />
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Tiles X" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding TilesX, Mode=TwoWay}"
                                                                               Minimum="1" Maximum="64" Increment="1" FormatString="0" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Tiles Y" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding TilesY, Mode=TwoWay}"
                                                                               Minimum="1" Maximum="64" Increment="1" FormatString="0" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Times the sheet plays over a lifetime">
                                                                <TextBlock Grid.Column="0" Text="Cycles" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding SheetCycles, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="1000" Increment="0.5" FormatString="0.##" />
                                                            </Grid>
                                                            <CheckBox Content="Random Start Frame" IsChecked="{Binding RandomStartFrame, Mode=TwoWay}" FontSize="11" />
                                                            <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                                       Text="Frames are read left to right, top to bottom. The built-in Smoke Sheet texture is 4 x 4." />
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="False" Header="Sub Emitters">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <CheckBox Content="Enabled" IsChecked="{Binding SubEmittersEnabled, Mode=TwoWay}" FontSize="11" />
                                                            <Grid ColumnDefinitions="*" ColumnSpacing="4">
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding SubEmitters}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="m:ParticleSubEmitterRowViewModel" x:DataType="m:ParticleSubEmitterRowViewModel">
                                                                        <StackPanel Spacing="4" Margin="0,0,0,8">
                                                                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="4">
                                                                                <ComboBox Grid.Column="0" Classes="field" HorizontalAlignment="Stretch"
                                                                                          ItemsSource="{x:Static m:ParticleSystemComponentViewModel.SubEmitterTriggers}"
                                                                                          SelectedItem="{Binding Trigger, Mode=TwoWay}" ToolTip.Tip="When it emits" />
                                                                                <TextBox Grid.Column="1" Classes="field" Text="{Binding Target, Mode=TwoWay}" Watermark="Gameobject name"
                                                                                         ToolTip.Tip="Gameobject with the Particle System that emits (Play On Awake off, Rate 0)" />
                                                                                <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove this row" />
                                                                            </Grid>
                                                                            <Grid ColumnDefinitions="*,*,*,Auto" ColumnSpacing="4">
                                                                                <NumericUpDown Grid.Column="0" Classes="field" Value="{Binding CountMin, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                               Minimum="0" Maximum="100000" Increment="1" FormatString="0" ToolTip.Tip="Particles per event, min (per second for Trail)" />
                                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding CountMax, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                               Minimum="0" Maximum="100000" Increment="1" FormatString="0" ToolTip.Tip="Particles per event, max (per second for Trail)" />
                                                                                <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding InheritVelocity, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                               Minimum="-10" Maximum="10" Increment="0.1" FormatString="0.##" ToolTip.Tip="Share of the parent particle's velocity" />
                                                                                <CheckBox Grid.Column="3" Content="Color" IsChecked="{Binding InheritColor, Mode=TwoWay}" FontSize="11"
                                                                                          ToolTip.Tip="Tint with the parent particle&apos;s colour" />
                                                                            </Grid>
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <Button Content="Add Sub Emitter" Command="{Binding AddSubEmitterCommand}" HorizontalAlignment="Stretch" />
                                                            <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                                       Text="Each target is another gameobject with a Particle System (Play On Awake off, Rate 0, World space). It emits from its own shape where this system's particles are born, trail, collide or die." />
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="True" Header="Renderer">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Render Mode" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{x:Static m:ParticleSystemComponentViewModel.RenderModes}"
                                                                          SelectedItem="{Binding RenderMode, Mode=TwoWay}" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Additive glows (fire, sparks); Alpha covers (smoke, dust)">
                                                                <TextBlock Grid.Column="0" Text="Blend" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{x:Static m:ParticleSystemComponentViewModel.BlendModes}"
                                                                          SelectedItem="{Binding Blend, Mode=TwoWay}" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Texture" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{x:Static m:ParticleSystemComponentViewModel.Textures}"
                                                                          SelectedItem="{Binding Texture, Mode=TwoWay}" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Custom only: a texture built by Content.mgcb, without extension">
                                                                <TextBlock Grid.Column="0" Text="Custom Texture" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <TextBox Grid.Column="1" Classes="field" Text="{Binding TexturePath, Mode=TwoWay}" Watermark="Content path, no extension" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Draw order inside this system (Alpha blending looks best sorted by distance)">
                                                                <TextBlock Grid.Column="0" Text="Sort Mode" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{x:Static m:ParticleSystemComponentViewModel.SortModes}"
                                                                          SelectedItem="{Binding SortMode, Mode=TwoWay}" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Multiplies the colour; above 1 blooms">
                                                                <TextBlock Grid.Column="0" Text="Brightness" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Brightness, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="1000" Increment="0.25" FormatString="0.##" />
                                                            </Grid>
                                                            <CheckBox Content="Lit" IsChecked="{Binding Lit, Mode=TwoWay}" FontSize="11" ToolTip.Tip="Shaded by the sun and sky (smoke, dust) instead of full colour" />
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Metres over which particles fade into geometry">
                                                                <TextBlock Grid.Column="0" Text="Soft Particles" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding SoftParticles, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Metres in front of the camera over which particles fade in">
                                                                <TextBlock Grid.Column="0" Text="Camera Fade" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding CameraFade, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="100" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Stretched only: length as a multiple of the size">
                                                                <TextBlock Grid.Column="0" Text="Length Scale" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding LengthScale, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="1000" Increment="0.5" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Stretched only: extra length per m/s">
                                                                <TextBlock Grid.Column="0" Text="Speed Scale" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding SpeedScale, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="1000" Increment="0.01" FormatString="0.###" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="False" Header="Lights">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <CheckBox Content="Enabled" IsChecked="{Binding LightsEnabled, Mode=TwoWay}" FontSize="11"
                                                                      ToolTip.Tip="The particles light the scene (point lights that follow them and die with them)" />
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="System: one light at the particles' glowing centre (fire, torch, explosion). Per Particle: lights riding on some particles (sparks, fireworks)">
                                                                <TextBlock Grid.Column="0" Text="Mode" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{x:Static m:ParticleSystemComponentViewModel.LightModes}"
                                                                          SelectedItem="{Binding LightMode, Mode=TwoWay}" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8">
                                                                <TextBlock Grid.Column="0" Text="Color" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                                                                    <Border Width="44" Height="18" CornerRadius="3"
                                                                            Background="{Binding LightColor, Converter={StaticResource ColorToBrush}}"
                                                                            BorderBrush="{StaticResource AnvilBorderBrush}" BorderThickness="1" />
                                                                    <Button.Flyout>
                                                                        <!-- OwnedFlyout_Opening pins the picker to this field. -->
                                                                        <Flyout Opening="OwnedFlyout_Opening">
                                                                            <ColorPicker x:DataType="m:ParticleSystemComponentViewModel" Color="{Binding LightColor, Mode=TwoWay}" />
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </Grid>
                                                            <CheckBox Content="Use Particle Color" IsChecked="{Binding LightUseParticleColor, Mode=TwoWay}" FontSize="11"
                                                                      ToolTip.Tip="Take the hue of the particles instead of Color" />
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Same scale as a Point Light's intensity">
                                                                <TextBlock Grid.Column="0" Text="Intensity" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding LightIntensity, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="100000" Increment="0.5" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Metres the light reaches">
                                                                <TextBlock Grid.Column="0" Text="Range" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding LightRange, Mode=TwoWay}"
                                                                               Minimum="0.1" Maximum="1000" Increment="0.5" FormatString="0.##" />
                                                            </Grid>
                                                            <CheckBox Content="Alpha Affects Intensity" IsChecked="{Binding LightAlphaAffectsIntensity, Mode=TwoWay}" FontSize="11"
                                                                      ToolTip.Tip="System: the light follows how much the particles glow (fades as a fire dies or a blast cools). Per Particle: each particle's alpha dims its light" />
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="0..1: how much the intensity wavers (0.3 a campfire, 0.6 a torch in the wind)">
                                                                <TextBlock Grid.Column="0" Text="Flicker" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding LightFlicker, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Flickers per second, roughly">
                                                                <TextBlock Grid.Column="0" Text="Flicker Speed" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding LightFlickerSpeed, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="100" Increment="1" FormatString="0.#" />
                                                            </Grid>
                                                            <StackPanel Spacing="6" IsVisible="{Binding IsSystemLight}">
                                                                <Grid ColumnDefinitions="96,*,*,*" ColumnSpacing="4" ToolTip.Tip="Offset from the particles' glowing centre (world metres, Z up)">
                                                                    <TextBlock Grid.Column="0" Text="Offset" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                    <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding LightOffsetX, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                   Minimum="-1000" Maximum="1000" FormatString="0.##" ToolTip.Tip="X" />
                                                                    <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding LightOffsetY, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                   Minimum="-1000" Maximum="1000" FormatString="0.##" ToolTip.Tip="Y" />
                                                                    <NumericUpDown Grid.Column="3" Classes="field" Value="{Binding LightOffsetZ, Mode=TwoWay}" ShowButtonSpinner="False"
                                                                                   Minimum="-1000" Maximum="1000" FormatString="0.##" ToolTip.Tip="Z" />
                                                                </Grid>
                                                                <CheckBox Content="Cast Shadows" IsChecked="{Binding LightCastShadows, Mode=TwoWay}" FontSize="11"
                                                                          ToolTip.Tip="Point light shadows (six shadow faces redrawn whenever the light moves: costly)" />
                                                            </StackPanel>
                                                            <StackPanel Spacing="6" IsVisible="{Binding IsPerParticleLight}">
                                                                <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Share of the particles that carry a light, 0..1">
                                                                    <TextBlock Grid.Column="0" Text="Ratio" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                    <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding LightRatio, Mode=TwoWay}"
                                                                                   Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" />
                                                                </Grid>
                                                                <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Most lights at once (the brightest carriers win), up to 16">
                                                                    <TextBlock Grid.Column="0" Text="Max Lights" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                    <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding LightMaxLights, Mode=TwoWay}"
                                                                                   Minimum="0" Maximum="16" Increment="1" FormatString="0" />
                                                                </Grid>
                                                                <CheckBox Content="Size Affects Range" IsChecked="{Binding LightSizeAffectsRange, Mode=TwoWay}" FontSize="11"
                                                                          ToolTip.Tip="The range grows and shrinks with the particle (relative to its start size)" />
                                                            </StackPanel>
                                                            <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                                       Text="Particle lights join the scene's point lights for lighting, forward materials, volumetric fog and Lit particles (the volumetric fog uses the first 8 lights). They play in the editor preview too." />
                                                        </StackPanel>
                                                    </Expander>
                                                    <Expander IsExpanded="False" Header="Volumetric">
                                                        <StackPanel Spacing="6" Margin="8,6,8,8">
                                                            <CheckBox Content="Enabled" IsChecked="{Binding VolumetricEnabled, Mode=TwoWay}" FontSize="11"
                                                                      ToolTip.Tip="Draw the system as a lit, raymarched volume instead of billboards" />
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Particles: each particle adds a soft ball of density. Voxels: a Counter-Strike 2 style smoke that floods the room from the emitter, blocked by Static colliders">
                                                                <TextBlock Grid.Column="0" Text="Source" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{x:Static m:ParticleSystemComponentViewModel.VolumeSources}"
                                                                          SelectedItem="{Binding VolumeSource, Mode=TwoWay}" />
                                                            </Grid>
                                                            <CheckBox Content="Draw Particles" IsChecked="{Binding VolumeDrawParticles, Mode=TwoWay}" FontSize="11"
                                                                      ToolTip.Tip="Also draw the particles as billboards (e.g. the jet of smoke from a grenade)" />
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Extinction per metre at full density: higher is thicker">
                                                                <TextBlock Grid.Column="0" Text="Density" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding VolumeDensity, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="1000" Increment="0.5" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="How far the detail noise eats into the volume (wispy edges)">
                                                                <TextBlock Grid.Column="0" Text="Noise Erosion" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding VolumeNoiseErosion, Mode=TwoWay}"
                                                                               Minimum="0" Maximum="1" Increment="0.05" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Noise features per metre">
                                                                <TextBlock Grid.Column="0" Text="Noise Scale" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding VolumeNoiseScale, Mode=TwoWay}"
                                                                               Minimum="0.001" Maximum="100" Increment="0.1" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Metres per second the noise rises (rolling smoke)">
                                                                <TextBlock Grid.Column="0" Text="Noise Speed" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding VolumeNoiseSpeed, Mode=TwoWay}"
                                                                               Minimum="-100" Maximum="100" Increment="0.05" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Most raymarch samples per pixel (quality vs. cost)">
                                                                <TextBlock Grid.Column="0" Text="Steps" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding VolumeSteps, Mode=TwoWay}"
                                                                               Minimum="8" Maximum="128" Increment="8" FormatString="0" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Seconds a bullet tunnel or blast hole takes to fill in (CarveTunnel / CarveHole)">
                                                                <TextBlock Grid.Column="0" Text="Refill Time" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding VolumeRefillTime, Mode=TwoWay}"
                                                                               Minimum="0.01" Maximum="1000" Increment="0.25" FormatString="0.##" />
                                                            </Grid>
                                                            <Grid ColumnDefinitions="96,*" ColumnSpacing="8" IsVisible="{Binding IsParticleSource}" ToolTip.Tip="Grid cells along the longest side of the particles' bounds">
                                                                <TextBlock Grid.Column="0" Text="Resolution" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding VolumeResolution, Mode=TwoWay}"
                                                                               Minimum="4" Maximum="62" Increment="4" FormatString="0" />
                                                            </Grid>
                                                            <StackPanel Spacing="6" IsVisible="{Binding IsVoxelSource}">
                                                                <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Edge of one voxel, metres">
                                                                    <TextBlock Grid.Column="0" Text="Voxel Size" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                    <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding VoxelSize, Mode=TwoWay}"
                                                                                   Minimum="0.05" Maximum="4" Increment="0.05" FormatString="0.##" />
                                                                </Grid>
                                                                <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Cubic metres the smoke fills: a corridor gets a long smoke, a room a round one">
                                                                    <TextBlock Grid.Column="0" Text="Volume" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                    <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding VoxelVolume, Mode=TwoWay}"
                                                                                   Minimum="0" Maximum="100000" Increment="10" FormatString="0.#" />
                                                                </Grid>
                                                                <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Furthest the smoke spreads from the emitter, metres">
                                                                    <TextBlock Grid.Column="0" Text="Max Radius" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                    <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding VoxelMaxRadius, Mode=TwoWay}"
                                                                                   Minimum="0.25" Maximum="100" Increment="0.5" FormatString="0.##" />
                                                                </Grid>
                                                                <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Seconds the smoke takes to bloom to its full volume">
                                                                    <TextBlock Grid.Column="0" Text="Expand Time" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                    <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding VoxelExpandTime, Mode=TwoWay}"
                                                                                   Minimum="0.01" Maximum="1000" Increment="0.1" FormatString="0.##" />
                                                                </Grid>
                                                                <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Seconds it takes to dissipate once the system stops emitting (Duration sets how long it holds)">
                                                                    <TextBlock Grid.Column="0" Text="Fade Time" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                    <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding VoxelFadeTime, Mode=TwoWay}"
                                                                                   Minimum="0.01" Maximum="1000" Increment="0.25" FormatString="0.##" />
                                                                </Grid>
                                                                <Grid ColumnDefinitions="96,*" ColumnSpacing="8" ToolTip.Tip="Cost of spreading upwards: above 1 the smoke spreads wider than tall">
                                                                    <TextBlock Grid.Column="0" Text="Flatten" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                                    <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding VoxelFlatten, Mode=TwoWay}"
                                                                                   Minimum="0.1" Maximum="10" Increment="0.1" FormatString="0.##" />
                                                                </Grid>
                                                            </StackPanel>
                                                            <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                                       Text="Renderer Lit, Brightness and Blend apply to the volume. Voxels use Start Color and flood while the system emits (Duration), then fade. Scripts: CarveTunnel(from, to) for bullets, CarveHole(center, radius) for blasts, Opacity(from, to) for line of sight." />
                                                        </StackPanel>
                                                    </Expander>
                                                    <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap"
                                                               Text="Unity-style particle system. Particles start from the Shape at this gameobject and change over their lifetime through the modules. Play On Awake systems also play while editing. Scripts: GetComponent&lt;ParticleSystemComponent&gt;().Play() / Stop() / Emit(n) / EmitAt(position, n)." />
                                                    <Button Content="Remove Component" Command="{Binding RemoveCommand}" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                        <DataTemplate DataType="m:ScriptBehaviourComponentViewModel" x:DataType="m:ScriptBehaviourComponentViewModel">
                                            <Expander IsExpanded="True" Header="{Binding DisplayName}">
                                                <StackPanel Spacing="8" Margin="12,8,12,12">
                                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" FontSize="11" />
                                                    <TextBlock Text="Script" Classes="muted" FontSize="11" />
                                                    <ComboBox Classes="field" HorizontalAlignment="Stretch"
                                                              ItemsSource="{Binding AvailableScripts}"
                                                              SelectedItem="{Binding SelectedScript, Mode=TwoWay}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate x:DataType="scripting:ScriptDefinition">
                                                                <TextBlock Text="{Binding DisplayName}" />
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBlock Text="{Binding ScriptId}" Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                                    <!-- Serialized fields: public / [SerializeField] fields of the script (Engine.Scripting.ScriptFields).
                                                         Each row is label + editor (picked by the field view model's type) + reset. -->
                                                    <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding HasFields}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.DataTemplates>
                                                            <DataTemplate DataType="m:ScriptBoolFieldViewModel" x:DataType="m:ScriptBoolFieldViewModel">
                                                                <CheckBox IsChecked="{Binding Value, Mode=TwoWay}" />
                                                            </DataTemplate>
                                                            <!-- Before the number template: a range field is also a number field. -->
                                                            <DataTemplate DataType="m:ScriptRangeFieldViewModel" x:DataType="m:ScriptRangeFieldViewModel">
                                                                <Grid ColumnDefinitions="*,56" ColumnSpacing="6">
                                                                    <Slider Grid.Column="0" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                                                            Value="{Binding SliderValue, Mode=TwoWay}"
                                                                            IsSnapToTickEnabled="{Binding IsInteger}" TickFrequency="1"
                                                                            MinHeight="18" />
                                                                    <NumericUpDown Grid.Column="1" Classes="field"
                                                                                   Value="{Binding Value, Mode=TwoWay}"
                                                                                   ShowButtonSpinner="False" FormatString="{Binding FormatString}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                            <DataTemplate DataType="m:ScriptNumberFieldViewModel" x:DataType="m:ScriptNumberFieldViewModel">
                                                                <NumericUpDown Classes="field" HorizontalAlignment="Stretch"
                                                                               Value="{Binding Value, Mode=TwoWay}"
                                                                               ShowButtonSpinner="False" FormatString="{Binding FormatString}" />
                                                            </DataTemplate>
                                                            <DataTemplate DataType="m:ScriptTextFieldViewModel" x:DataType="m:ScriptTextFieldViewModel">
                                                                <TextBox Classes="field" Text="{Binding Value, Mode=TwoWay}" FontSize="11" />
                                                            </DataTemplate>
                                                            <DataTemplate DataType="m:ScriptEnumFieldViewModel" x:DataType="m:ScriptEnumFieldViewModel">
                                                                <ComboBox Classes="field" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{Binding Options}"
                                                                          SelectedItem="{Binding Value, Mode=TwoWay}" />
                                                            </DataTemplate>
                                                            <DataTemplate DataType="m:ScriptVectorFieldViewModel" x:DataType="m:ScriptVectorFieldViewModel">
                                                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="4">
                                                                    <NumericUpDown Grid.Column="0" Classes="field" Value="{Binding X, Mode=TwoWay}"
                                                                                   ShowButtonSpinner="False" FormatString="0.##" ToolTip.Tip="X" />
                                                                    <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding Y, Mode=TwoWay}"
                                                                                   ShowButtonSpinner="False" FormatString="0.##" ToolTip.Tip="Y" />
                                                                    <NumericUpDown Grid.Column="2" Classes="field" Value="{Binding Z, Mode=TwoWay}" IsVisible="{Binding HasZ}"
                                                                                   ShowButtonSpinner="False" FormatString="0.##" ToolTip.Tip="Z" />
                                                                </Grid>
                                                            </DataTemplate>
                                                            <DataTemplate DataType="m:ScriptColorFieldViewModel" x:DataType="m:ScriptColorFieldViewModel">
                                                                <Button Background="Transparent" BorderThickness="0" Padding="0"
                                                                        HorizontalAlignment="Left">
                                                                    <Border Width="28" Height="20" CornerRadius="3"
                                                                            Background="{Binding Value, Converter={StaticResource ColorToBrush}}"
                                                                            BorderBrush="{StaticResource AnvilBorderBrush}" BorderThickness="1" />
                                                                    <Button.Flyout>
                                                                        <!-- OwnedFlyout_Opening pins the picker to this field. -->
                                                                        <Flyout Opening="OwnedFlyout_Opening">
                                                                            <ColorPicker x:DataType="m:ScriptColorFieldViewModel" Color="{Binding Value, Mode=TwoWay}" />
                                                                        </Flyout>
                                                                    </Button.Flyout>
                                                                </Button>
                                                            </DataTemplate>
                                                            <DataTemplate DataType="m:ScriptGameObjectFieldViewModel" x:DataType="m:ScriptGameObjectFieldViewModel">
                                                                <ComboBox Classes="field" HorizontalAlignment="Stretch"
                                                                          ItemsSource="{Binding Options}"
                                                                          SelectedItem="{Binding Value, Mode=TwoWay}">
                                                                    <ComboBox.ItemTemplate>
                                                                        <DataTemplate x:DataType="m:GameObjectOption">
                                                                            <TextBlock Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                                        </DataTemplate>
                                                                    </ComboBox.ItemTemplate>
                                                                </ComboBox>
                                                            </DataTemplate>
                                                        </ItemsControl.DataTemplates>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="m:ScriptFieldViewModel">
                                                                <Grid ColumnDefinitions="90,*,22" ColumnSpacing="6">
                                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" ToolTip.Tip="{Binding Tooltip}"
                                                                               Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <ContentControl Grid.Column="1" Content="{Binding}" VerticalAlignment="Center" />
                                                                    <Button Grid.Column="2" Classes="iconButton" Padding="2"
                                                                            Command="{Binding ResetCommand}" IsVisible="{Binding IsOverridden}"
                                                                            ToolTip.Tip="Reset to the script's default">
                                                                        <controls:LucideIcon Icon="RotateCcw" Width="12" Height="12" />
                                                                    </Button>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="Start runs once; Update runs each frame in Play mode." Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                                    <TextBlock Text="Add another Script Behaviour to run more scripts on this object." Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                                    <Button Content="Remove Component" Command="{Binding RemoveCommand}" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                        <DataTemplate DataType="m:AudioComponentViewModel" x:DataType="m:AudioComponentViewModel">
                                            <Expander IsExpanded="True">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <controls:LucideIcon Icon="Volume2" Foreground="{StaticResource AnvilAudioBrush}" />
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Spacing="8" Margin="12,8,12,12">
                                                    <CheckBox Content="Enabled" IsChecked="{Binding Enabled, Mode=TwoWay}" FontSize="11" />
                                                    <Border Padding="10" MinHeight="52" CornerRadius="4"
                                                            Background="{StaticResource AnvilSubtleBandBrush}"
                                                            BorderBrush="{StaticResource AnvilBorderBrush}" BorderThickness="1"
                                                            DragDrop.AllowDrop="True"
                                                            DragDrop.DragOver="AudioClip_DragOver" DragDrop.Drop="AudioClip_Drop">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="Audio Clip" Classes="muted" FontSize="10" />
                                                            <TextBlock Text="{Binding ClipLabel}" FontSize="11" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="Drag a WAV, MP3, OGG or FLAC file from Assets." Classes="muted" FontSize="10" TextWrapping="Wrap" />
                                                    <Grid ColumnDefinitions="60,*,40" ColumnSpacing="8">
                                                        <TextBlock Text="Volume" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" MinHeight="18" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:0.00}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="60,*" ColumnSpacing="8"
                                                          ToolTip.Tip="Mixer bus: the game menus' Effects or Music volume applies to it">
                                                        <TextBlock Text="Output" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                                  ItemsSource="{x:Static m:AudioComponentViewModel.Outputs}"
                                                                  SelectedItem="{Binding Output, Mode=TwoWay}" />
                                                    </Grid>
                                                    <CheckBox Content="Loop" IsChecked="{Binding Loop, Mode=TwoWay}" FontSize="11" />
                                                    <CheckBox Content="Play on Start" IsChecked="{Binding PlayOnStart, Mode=TwoWay}" FontSize="11" />
                                                    <CheckBox Content="3D Spatial Audio" IsChecked="{Binding Spatial, Mode=TwoWay}" FontSize="11" />
                                                    <Grid ColumnDefinitions="60,*,60,*" ColumnSpacing="6" IsVisible="{Binding Spatial}"
                                                          ToolTip.Tip="Full volume within Min distance, quieter with distance up to Max">
                                                        <TextBlock Text="Min Dist" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding MinDistance, Mode=TwoWay}"
                                                                       Minimum="0.01" ShowButtonSpinner="False" FormatString="0.##" />
                                                        <TextBlock Grid.Column="2" Text="Max Dist" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                                        <NumericUpDown Grid.Column="3" Classes="field" Value="{Binding MaxDistance, Mode=TwoWay}"
                                                                       Minimum="0.01" ShowButtonSpinner="False" FormatString="0.#" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Button Content="Play" Command="{Binding PlayCommand}" />
                                                        <Button Content="Stop" Command="{Binding StopCommand}" />
                                                        <Button Content="Clear Clip" Command="{Binding ClearClipCommand}" />
                                                    </StackPanel>
                                                    <Button Content="Remove Component" Command="{Binding RemoveCommand}" HorizontalAlignment="Stretch" />
                                                </StackPanel>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.DataTemplates>
                                </ItemsControl>

                                <!-- AddComponentButton_Click builds a fresh menu for the shown gameobject on every
                                     click; a reused MenuFlyout kept running the first gameobject's commands. -->
                                <Button Content="Add Component" Margin="12" HorizontalAlignment="Stretch"
                                        IsVisible="{Binding CanAddComponents}"
                                        Click="AddComponentButton_Click" />

                                <!-- Camera -->
                                <Expander IsExpanded="True"
                                          IsVisible="{Binding Camera, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LucideIcon Icon="Camera"
                                                  Foreground="{StaticResource AnvilCameraBrush}" />
                                            <TextBlock Text="Camera" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="8" Margin="12,8,12,12"
                                                DataContext="{Binding Camera}"
                                                x:DataType="m:CameraInfo">
                                        <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="FOV"
                                                       Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Column="1" Classes="field"
                                                           Value="{Binding Fov, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.#" />
                                        </Grid>
                                        <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Near"
                                                       Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Column="1" Classes="field"
                                                           Value="{Binding Near, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.##" />
                                        </Grid>
                                        <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Far"
                                                       Classes="muted" FontSize="11"
                                                       VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Column="1" Classes="field"
                                                           Value="{Binding Far, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.#" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>

                        <!-- Post Processing view: global render settings (formerly the
                             HelperSuite right-side panel). Bound through PostProcessing
                             VM, which marshals writes onto the engine's game thread. -->
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding IsInspectorPostProcessingView}">
                            <StackPanel Spacing="0" DataContext="{Binding PostProcessing}"
                                        x:DataType="m:PostProcessingViewModel">

                                <!-- Tone mapping / colour -->
                                <Expander IsExpanded="True">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LucideIcon Icon="Wand" />
                                            <TextBlock Text="Post Processing" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="6" Margin="12,8,12,12">
                                        <CheckBox Content="Temporal AA"
                                                  IsChecked="{Binding Taa, Mode=TwoWay}" />
                                        <CheckBox Content="Tonemap TAA"
                                                  IsChecked="{Binding TonemapTaa, Mode=TwoWay}" />
                                        <CheckBox Content="Color Grading"
                                                  IsChecked="{Binding ColorGrading, Mode=TwoWay}" />

                                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto"
                                              RowSpacing="6">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="White Point"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="4" Increment="0.05"
                                                           Value="{Binding WhitePoint, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.00" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Exposure"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="field"
                                                           Minimum="-8" Maximum="8" Increment="0.05"
                                                           Value="{Binding Exposure, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.00" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="S-Curve"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="field"
                                                           Minimum="-1" Maximum="1" Increment="0.01"
                                                           Value="{Binding SCurveStrength, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.00" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Chr. Aberr."
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="3" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="1" Increment="0.005"
                                                           Value="{Binding ChromaticAberration, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.000" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!-- Eye adaptation / auto exposure: EV on top of the Exposure above -->
                                <Expander IsExpanded="True">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LucideIcon Icon="Eye" />
                                            <TextBlock Text="Eye Adaptation" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="6" Margin="12,8,12,12">
                                        <CheckBox Content="Auto Exposure"
                                                  IsChecked="{Binding AutoExposure, Mode=TwoWay}" />
                                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                              RowSpacing="6" IsEnabled="{Binding AutoExposure}">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Key Value"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="field"
                                                           Minimum="0.01" Maximum="1" Increment="0.01"
                                                           Value="{Binding AutoExposureKey, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.00" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Min EV"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="field"
                                                           Minimum="-10" Maximum="10" Increment="0.25"
                                                           Value="{Binding AutoExposureMin, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.00" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Max EV"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="field"
                                                           Minimum="-10" Maximum="10" Increment="0.25"
                                                           Value="{Binding AutoExposureMax, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.00" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Dark → Light"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="3" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="20" Increment="0.1"
                                                           Value="{Binding AutoExposureSpeedDarkToLight, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.0" />
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Light → Dark"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="4" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="20" Increment="0.1"
                                                           Value="{Binding AutoExposureSpeedLightToDark, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.0" />
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Center Weight"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="5" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="1" Increment="0.05"
                                                           Value="{Binding AutoExposureCenterWeight, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.00" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!-- Bloom -->
                                <Expander IsExpanded="True">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LucideIcon Icon="Sun" />
                                            <TextBlock Text="Bloom" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="6" Margin="12,8,12,12">
                                        <CheckBox Content="Enable Bloom"
                                                  IsChecked="{Binding BloomEnabled, Mode=TwoWay}" />
                                        <Grid ColumnDefinitions="100,*" RowSpacing="6">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Threshold"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="4" Increment="0.05"
                                                           Value="{Binding BloomThreshold, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.00" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="MIP0 Radius"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="8" Increment="0.1"
                                                           Value="{Binding BloomRadius1, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.0" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="MIP0 Strength"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="8" Increment="0.1"
                                                           Value="{Binding BloomStrength1, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.0" />
                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="MIP1 Radius"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="3" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="8" Increment="0.1"
                                                           Value="{Binding BloomRadius2, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.0" />
                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="MIP1 Strength"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="4" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="8" Increment="0.1"
                                                           Value="{Binding BloomStrength2, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.0" />
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="MIP2 Radius"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="5" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="8" Increment="0.1"
                                                           Value="{Binding BloomRadius3, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.0" />
                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="MIP2 Strength"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="6" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="8" Increment="0.1"
                                                           Value="{Binding BloomStrength3, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.0" />
                                            <TextBlock Grid.Row="7" Grid.Column="0" Text="MIP3 Radius"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="7" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="8" Increment="0.1"
                                                           Value="{Binding BloomRadius4, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.0" />
                                            <TextBlock Grid.Row="8" Grid.Column="0" Text="MIP3 Strength"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="8" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="8" Increment="0.1"
                                                           Value="{Binding BloomStrength4, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.0" />
                                            <TextBlock Grid.Row="9" Grid.Column="0" Text="MIP4 Radius"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="9" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="8" Increment="0.1"
                                                           Value="{Binding BloomRadius5, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.0" />
                                            <TextBlock Grid.Row="10" Grid.Column="0" Text="MIP4 Strength"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="10" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="8" Increment="0.1"
                                                           Value="{Binding BloomStrength5, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.0" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!-- Volumetric Fog (froxels) -->
                                <Expander IsExpanded="False">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LucideIcon Icon="CloudFog" />
                                            <TextBlock Text="Volumetric Fog" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="6" Margin="12,8,12,12">
                                        <CheckBox Content="Enable Fog"
                                                  IsChecked="{Binding FogEnabled, Mode=TwoWay}" />
                                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto"
                                              RowSpacing="6" IsEnabled="{Binding FogEnabled}">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="History"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="0.98" Increment="0.05"
                                                           Value="{Binding FogHistoryBlend, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.00" />
                                        </Grid>
                                        <TextBlock Text="Density, scatter, distances and the sky are saved per scene: Environment > Volumetric Fog." TextWrapping="Wrap" Classes="muted" FontSize="11" />
                                    </StackPanel>
                                </Expander>

                                <!-- Screen-Space Reflections -->
                                <Expander IsExpanded="False">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LucideIcon Icon="Sparkles" />
                                            <TextBlock Text="Screen-Space Reflections" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="6" Margin="12,8,12,12">
                                        <CheckBox Content="Enable SSR"
                                                  IsChecked="{Binding SsrEnabled, Mode=TwoWay}" />
                                        <CheckBox Content="Stochastic Distribution"
                                                  IsChecked="{Binding SsrStochastic, Mode=TwoWay}" />
                                        <CheckBox Content="Temporal Noise"
                                                  IsChecked="{Binding SsrTemporalNoise, Mode=TwoWay}" />
                                        <CheckBox Content="Firefly Reduction"
                                                  IsChecked="{Binding SsrFireflyReduction, Mode=TwoWay}" />
                                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto"
                                              RowSpacing="6">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Firefly Thr."
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="5" Increment="0.05"
                                                           Value="{Binding SsrFireflyThreshold, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.00" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Samples"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="field"
                                                           Minimum="1" Maximum="100" Increment="1"
                                                           Value="{Binding SsrSamples, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Search Samples"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="field"
                                                           Minimum="1" Maximum="100" Increment="1"
                                                           Value="{Binding SsrRefinementSamples, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!-- Ambient Occlusion -->
                                <Expander IsExpanded="False">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LucideIcon Icon="Aperture" />
                                            <TextBlock Text="Ambient Occlusion" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="6" Margin="12,8,12,12">
                                        <CheckBox Content="Enable SSAO"
                                                  IsChecked="{Binding SsaoEnabled, Mode=TwoWay}" />
                                        <CheckBox Content="SSAO Blur"
                                                  IsChecked="{Binding SsaoBlur, Mode=TwoWay}" />
                                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto"
                                              RowSpacing="6">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Samples"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="field"
                                                           Minimum="1" Maximum="32" Increment="1"
                                                           Value="{Binding SsaoSamples, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Sample Radius"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="field"
                                                           Minimum="1" Maximum="100" Increment="0.5"
                                                           Value="{Binding SsaoRadius, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.0" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Strength"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="4" Increment="0.05"
                                                           Value="{Binding SsaoStrength, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.00" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!-- Viewport / SDF -->
                                <Expander IsExpanded="False">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LucideIcon Icon="Eye" />
                                            <TextBlock Text="Viewport" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="6" Margin="12,8,12,12">
                                        <CheckBox Content="Highlight Meshes"
                                                  IsChecked="{Binding HighlightMeshes, Mode=TwoWay}" />
                                        <CheckBox Content="Draw SDF distance"
                                                  IsChecked="{Binding DrawSdf, Mode=TwoWay}" />
                                        <CheckBox Content="Draw SDF volume"
                                                  IsChecked="{Binding DrawSdfVolume, Mode=TwoWay}" />
                                    </StackPanel>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>

                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding IsInspectorEnvironmentView}">
                            <StackPanel Spacing="14" Margin="12" DataContext="{Binding Environment}"
                                        x:DataType="m:EnvironmentViewModel" IsEnabled="{Binding IsReady}">
                                <TextBlock Text="Environment" FontSize="13" FontWeight="SemiBold" />
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Sky mode" Classes="muted" FontSize="11" />
                                    <ComboBox Classes="field" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding SkyModes}"
                                              SelectedIndex="{Binding SelectedSkyMode, Mode=TwoWay}"
                                              IsEnabled="{Binding CanChooseSkybox}" />
                                </StackPanel>
                                <StackPanel Spacing="8" IsVisible="{Binding IsCustomSkybox}">
                                    <TextBlock Text="{Binding SkyboxName}" TextWrapping="Wrap" FontSize="11" />
                                    <TextBlock Text="Choose a 360° equirectangular panorama (PNG or JPEG, ideally 2:1)."
                                               TextWrapping="Wrap" Classes="muted" FontSize="11" />
                                    <Button Content="Choose skybox…" Click="ChooseSkybox_Click"
                                            IsEnabled="{Binding CanChooseSkybox}" HorizontalAlignment="Stretch" />
                                    <Button Content="Reset to default" Command="{Binding ResetSkyboxCommand}"
                                            HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <StackPanel Spacing="8" IsVisible="{Binding IsDayNightCycle}">
                                    <TextBlock Text="Animated sky and sun lighting. The cycle runs in both Edit and Play."
                                               TextWrapping="Wrap" Classes="muted" FontSize="11" />
                                    <TextBlock Text="Starting hour (0–24)" Classes="muted" FontSize="11" />
                                    <NumericUpDown Classes="field" Minimum="0" Maximum="23.99" Increment="0.25"
                                                   Value="{Binding TimeOfDay, Mode=TwoWay}" FormatString="0.00" />
                                    <TextBlock Text="Full cycle duration (minutes)" Classes="muted" FontSize="11" />
                                    <NumericUpDown Classes="field" Minimum="0.1" Maximum="1440" Increment="0.5"
                                                   Value="{Binding CycleDurationMinutes, Mode=TwoWay}" FormatString="0.0" />
                                    <TextBlock Text="Changing the starting hour or duration restarts the cycle."
                                               TextWrapping="Wrap" Classes="muted" FontSize="11" />
                                    <TextBlock Text="Sky" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Day sky" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                                            <Border Width="44" Height="18" CornerRadius="3"
                                                    Background="{Binding DaySkyColor, Converter={StaticResource ColorToBrush}}"
                                                    BorderBrush="{StaticResource AnvilBorderBrush}" BorderThickness="1" />
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker Color="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Environment.DaySkyColor, Mode=TwoWay}" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Day horizon" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                                            <Border Width="44" Height="18" CornerRadius="3"
                                                    Background="{Binding DayHorizonColor, Converter={StaticResource ColorToBrush}}"
                                                    BorderBrush="{StaticResource AnvilBorderBrush}" BorderThickness="1" />
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker Color="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Environment.DayHorizonColor, Mode=TwoWay}" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Sunset" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                                            <Border Width="44" Height="18" CornerRadius="3"
                                                    Background="{Binding SunsetColor, Converter={StaticResource ColorToBrush}}"
                                                    BorderBrush="{StaticResource AnvilBorderBrush}" BorderThickness="1" />
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker Color="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Environment.SunsetColor, Mode=TwoWay}" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Night sky" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                                            <Border Width="44" Height="18" CornerRadius="3"
                                                    Background="{Binding NightSkyColor, Converter={StaticResource ColorToBrush}}"
                                                    BorderBrush="{StaticResource AnvilBorderBrush}" BorderThickness="1" />
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker Color="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Environment.NightSkyColor, Mode=TwoWay}" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Night horizon" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Left">
                                            <Border Width="44" Height="18" CornerRadius="3"
                                                    Background="{Binding NightHorizonColor, Converter={StaticResource ColorToBrush}}"
                                                    BorderBrush="{StaticResource AnvilBorderBrush}" BorderThickness="1" />
                                            <Button.Flyout>
                                                <Flyout>
                                                    <ColorPicker Color="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Environment.NightHorizonColor, Mode=TwoWay}" />
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="Sun, moon and stars" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Sun brightness" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding SunBrightness, Mode=TwoWay}" MinHeight="18" />
                                        <TextBlock Grid.Column="2" Text="{Binding SunBrightness, StringFormat={}{0:0.00}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Sun size" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0.25" Maximum="4" Value="{Binding SunSize, Mode=TwoWay}" MinHeight="18" />
                                        <TextBlock Grid.Column="2" Text="{Binding SunSize, StringFormat={}{0:0.00}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Moon brightness" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding MoonBrightness, Mode=TwoWay}" MinHeight="18" />
                                        <TextBlock Grid.Column="2" Text="{Binding MoonBrightness, StringFormat={}{0:0.00}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Moon size" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0.25" Maximum="4" Value="{Binding MoonSize, Mode=TwoWay}" MinHeight="18" />
                                        <TextBlock Grid.Column="2" Text="{Binding MoonSize, StringFormat={}{0:0.00}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Stars" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="3" Value="{Binding StarBrightness, Mode=TwoWay}" MinHeight="18" />
                                        <TextBlock Grid.Column="2" Text="{Binding StarBrightness, StringFormat={}{0:0.00}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Exposure" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Day (EV)" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="-4" Maximum="4" Value="{Binding DayExposure, Mode=TwoWay}" MinHeight="18" />
                                        <TextBlock Grid.Column="2" Text="{Binding DayExposure, StringFormat={}{0:0.00}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Night (EV)" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="-4" Maximum="4" Value="{Binding NightExposure, Mode=TwoWay}" MinHeight="18" />
                                        <TextBlock Grid.Column="2" Text="{Binding NightExposure, StringFormat={}{0:0.00}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Added to the Post FX exposure and blended by daylight. Lower night values make nights darker."
                                               TextWrapping="Wrap" Classes="muted" FontSize="11" />
                                    <Button Content="Reset sky look" Command="{Binding ResetSkyLookCommand}" HorizontalAlignment="Stretch" />
                                    <TextBlock Text="Clouds" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Coverage" Classes="muted" FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="1"
                                                Value="{Binding CloudCoverage, Mode=TwoWay}" MinHeight="18" />
                                        <TextBlock Grid.Column="2" Text="{Binding CloudCoverage, StringFormat={}{0:0.00}}"
                                                   Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Speed" Classes="muted" FontSize="11"
                                                   VerticalAlignment="Center" />
                                        <Slider Grid.Column="1" Minimum="0" Maximum="10"
                                                Value="{Binding CloudSpeed, Mode=TwoWay}" MinHeight="18" />
                                        <TextBlock Grid.Column="2" Text="{Binding CloudSpeed, StringFormat={}{0:0.00}}"
                                                   Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Text="Coverage 0 is a clear sky, 1 is overcast. Heavy cover also dims the sun."
                                               TextWrapping="Wrap" Classes="muted" FontSize="11" />
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Weather" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <ComboBox Classes="field" HorizontalAlignment="Stretch"
                                              ItemsSource="{Binding WeatherTypes}"
                                              SelectedIndex="{Binding SelectedWeather, Mode=TwoWay}" />
                                    <StackPanel Spacing="8" IsVisible="{Binding HasWeather}">
                                        <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Intensity" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding WeatherIntensity, Mode=TwoWay}" MinHeight="18" />
                                            <TextBlock Grid.Column="2" Text="{Binding WeatherIntensity, StringFormat={}{0:0.00}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Haze" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding WeatherHaze, Mode=TwoWay}" MinHeight="18" />
                                            <TextBlock Grid.Column="2" Text="{Binding WeatherHaze, StringFormat={}{0:0.00}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Wind (m/s)" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="40" Value="{Binding WindSpeed, Mode=TwoWay}" MinHeight="18" />
                                            <TextBlock Grid.Column="2" Text="{Binding WindSpeed, StringFormat={}{0:0.0}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Wind towards" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="359" Value="{Binding WindDirection, Mode=TwoWay}" MinHeight="18" />
                                            <TextBlock Grid.Column="2" Text="{Binding WindDirection, StringFormat={}{0:0}°}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="Wind angle: 0° blows towards +X, 90° towards +Y. A sandstorm always blows at least 7 m/s. With the day/night sky, weather also thickens the clouds and dims the sun."
                                                   TextWrapping="Wrap" Classes="muted" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Volumetric Fog" FontSize="12" FontWeight="SemiBold" Margin="0,6,0,0" />
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Density" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                   ToolTip.Tip="Fog everywhere (per metre), scaled by the distance ramp." />
                                        <NumericUpDown Grid.Column="1" Classes="field" Minimum="0.001" Maximum="5" Increment="0.005"
                                                       Value="{Binding FogDensity, Mode=TwoWay}" ShowButtonSpinner="False" FormatString="0.000" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Absorption" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                   ToolTip.Tip="How much of what is behind the fog it hides." />
                                        <NumericUpDown Grid.Column="1" Classes="field" Minimum="0" Maximum="1" Increment="0.01"
                                                       Value="{Binding FogAbsorption, Mode=TwoWay}" ShowButtonSpinner="False" FormatString="0.00" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Sun Scatter" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                   ToolTip.Tip="Brightness of sunlight in the fog: the light shafts." />
                                        <NumericUpDown Grid.Column="1" Classes="field" Minimum="0" Maximum="4" Increment="0.01"
                                                       Value="{Binding FogSunScatter, Mode=TwoWay}" ShowButtonSpinner="False" FormatString="0.00" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Light Scatter" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                   ToolTip.Tip="Brightness of point and spot lights in the fog." />
                                        <NumericUpDown Grid.Column="1" Classes="field" Minimum="0" Maximum="16" Increment="0.1"
                                                       Value="{Binding FogLightScatter, Mode=TwoWay}" ShowButtonSpinner="False" FormatString="0.0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Anisotropy" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                   ToolTip.Tip="0 glows evenly; towards 1 it glows mostly when looking at the light." />
                                        <NumericUpDown Grid.Column="1" Classes="field" Minimum="-0.95" Maximum="0.95" Increment="0.05"
                                                       Value="{Binding FogAnisotropy, Mode=TwoWay}" ShowButtonSpinner="False" FormatString="0.00" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Start Dist." Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                   ToolTip.Tip="Metres from the camera where the density starts ramping up." />
                                        <NumericUpDown Grid.Column="1" Classes="field" Minimum="0" Maximum="5000" Increment="5"
                                                       Value="{Binding FogStartDistance, Mode=TwoWay}" ShowButtonSpinner="False" FormatString="0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Full Dist." Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                   ToolTip.Tip="Metres from the camera where the density is full." />
                                        <NumericUpDown Grid.Column="1" Classes="field" Minimum="1" Maximum="10000" Increment="10"
                                                       Value="{Binding FogFullDistance, Mode=TwoWay}" ShowButtonSpinner="False" FormatString="0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Near Density" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                   ToolTip.Tip="Fraction of the density kept before Start Dist. (1 = no ramp)." />
                                        <NumericUpDown Grid.Column="1" Classes="field" Minimum="0" Maximum="1" Increment="0.05"
                                                       Value="{Binding FogNearDensity, Mode=TwoWay}" ShowButtonSpinner="False" FormatString="0.00" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Sky Fog" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                   ToolTip.Tip="How much far fog covers the sky." />
                                        <NumericUpDown Grid.Column="1" Classes="field" Minimum="0" Maximum="1" Increment="0.05"
                                                       Value="{Binding FogSkyStrength, Mode=TwoWay}" ShowButtonSpinner="False" FormatString="0.00" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Sky Shafts" Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                   ToolTip.Tip="Fog in front of the sky up to this distance (m) stays whole, so shafts show when facing the sun." />
                                        <NumericUpDown Grid.Column="1" Classes="field" Minimum="0" Maximum="10000" Increment="10"
                                                       Value="{Binding FogSkyShaftDistance, Mode=TwoWay}" ShowButtonSpinner="False" FormatString="0" />
                                    </Grid>
                                    <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="Max Auto Exp." Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                   ToolTip.Tip="Caps how far auto exposure brightens dark views (EV). Lower keeps dark rooms dark." />
                                        <NumericUpDown Grid.Column="1" Classes="field" Minimum="-3" Maximum="3" Increment="0.25"
                                                       Value="{Binding MaxAutoExposure, Mode=TwoWay}" ShowButtonSpinner="False" FormatString="0.00" />
                                    </Grid>
                                    <TextBlock Text="Saved with the scene. Denser pockets (a dusty room with light shafts) are Fog Volume components. Shafts only form inside the sun's shadow box (Directional light > Shadow Size)."
                                               TextWrapping="Wrap" Classes="muted" FontSize="11" />
                                    <Button Content="Reset fog" Command="{Binding ResetFogCommand}" HorizontalAlignment="Stretch" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="11" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- World panel - opened by the viewport toolbar's World button. World
                             generation settings are part of the scene environment. -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding IsInspectorWorldView}">
                            <StackPanel Spacing="14" Margin="12" DataContext="{Binding Environment}"
                                        x:DataType="m:EnvironmentViewModel" IsEnabled="{Binding IsReady}">
                                <TextBlock Text="World" FontSize="13" FontWeight="SemiBold" />
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Voxel World" FontSize="12" FontWeight="SemiBold" />
                                    <CheckBox Content="Generate a voxel world" IsChecked="{Binding VoxelsEnabled, Mode=TwoWay}" FontSize="11" />
                                    <StackPanel Spacing="8" IsVisible="{Binding VoxelsEnabled}">
                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Terrain" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" Classes="field" HorizontalAlignment="Stretch"
                                                      ItemsSource="{Binding VoxelTerrains}"
                                                      SelectedIndex="{Binding SelectedVoxelTerrain, Mode=TwoWay}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Seed" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding VoxelSeed, Mode=TwoWay}"
                                                           Minimum="-2147483648" Maximum="2147483647" Increment="1" FormatString="0" />
                                            <Button Grid.Column="2" Content="New seed" Command="{Binding NewVoxelSeedCommand}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Size (blocks)" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="32" Maximum="256" TickFrequency="32" IsSnapToTickEnabled="True"
                                                    Value="{Binding VoxelWorldSize, Mode=TwoWay}" MinHeight="18" />
                                            <TextBlock Grid.Column="2" Text="{Binding VoxelWorldSize, StringFormat={}{0:0}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Height (blocks)" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="16" Maximum="128" TickFrequency="16" IsSnapToTickEnabled="True"
                                                    Value="{Binding VoxelWorldHeight, Mode=TwoWay}" MinHeight="18" />
                                            <TextBlock Grid.Column="2" Text="{Binding VoxelWorldHeight, StringFormat={}{0:0}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Block size (m)" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0.25" Maximum="4" TickFrequency="0.25" IsSnapToTickEnabled="True"
                                                    Value="{Binding VoxelBlockSize, Mode=TwoWay}" MinHeight="18" />
                                            <TextBlock Grid.Column="2" Text="{Binding VoxelBlockSize, StringFormat={}{0:0.00}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="90,*" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Floor Z (m)" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Column="1" Classes="field" Value="{Binding VoxelBaseHeight, Mode=TwoWay}"
                                                           Minimum="-1000" Maximum="1000" Increment="1" FormatString="0.##" />
                                        </Grid>
                                        <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Trees" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding VoxelTrees, Mode=TwoWay}" MinHeight="18" />
                                            <TextBlock Grid.Column="2" Text="{Binding VoxelTrees, StringFormat={}{0:0.00}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <Grid ColumnDefinitions="90,*,40" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="Sea level" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <Slider Grid.Column="1" Minimum="0" Maximum="0.9" Value="{Binding VoxelSeaLevel, Mode=TwoWay}" MinHeight="18" />
                                            <TextBlock Grid.Column="2" Text="{Binding VoxelSeaLevel, StringFormat={}{0:0.00}}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                        </Grid>
                                        <CheckBox Content="Caves" IsChecked="{Binding VoxelCaves, Mode=TwoWay}" FontSize="11" />
                                        <CheckBox Content="Collision" IsChecked="{Binding VoxelCollision, Mode=TwoWay}" FontSize="11" />
                                        <TextBlock Text="{Binding VoxelSummary}" Classes="muted" FontSize="11" TextWrapping="Wrap" />
                                        <TextBlock Text="Changing a setting regenerates the world (in the background while editing). The world is centred on X/Y = 0 and its floor is at Floor Z. Sea level is a fraction of the height; 0 means no water. Scripts dig and build through ScriptBehaviour.Voxels, and Stop puts the generated world back."
                                                   TextWrapping="Wrap" Classes="muted" FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="11" />
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Lighting (baked probe volume) panel - visible when the inspector is
                             switched to Lighting. Settings are per scene and saved with it. -->
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Disabled"
                                      IsVisible="{Binding IsInspectorLightingView}">
                            <StackPanel Spacing="0" DataContext="{Binding Lighting}"
                                        x:DataType="m:LightingViewModel">

                                <!-- Bake -->
                                <Expander IsExpanded="True">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LucideIcon Icon="Flame" />
                                            <TextBlock Text="Bake" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="8" Margin="12,8,12,12">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="Bake Lighting" Command="{Binding BakeCommand}"
                                                    IsVisible="{Binding IsIdle}" />
                                            <Button Content="Cancel" Command="{Binding CancelBakeCommand}"
                                                    IsVisible="{Binding IsBaking}" />
                                            <Button Content="Clear" Command="{Binding ClearBakeCommand}" />
                                        </StackPanel>
                                        <StackPanel Spacing="4" IsVisible="{Binding IsBaking}">
                                            <ProgressBar Minimum="0" Maximum="100" Height="6" MinHeight="6"
                                                         Value="{Binding BakeProgress}" />
                                            <TextBlock Text="{Binding BakeStage}" FontSize="10.5"
                                                       Classes="muted" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding StatusMessage}" FontSize="10.5"
                                                   TextWrapping="Wrap" Classes="muted"
                                                   IsVisible="{Binding IsIdle}" />
                                        <TextBlock Text="{Binding BakedSummary}" FontSize="10.5"
                                                   TextWrapping="Wrap" Classes="subtle"
                                                   IsVisible="{Binding HasBakedData}" />
                                        <TextBlock Text="Not baked. Saving the scene stores the bake as a .probes file next to the .obsc."
                                                   FontSize="10.5" TextWrapping="Wrap" Classes="subtle"
                                                   IsVisible="{Binding !HasBakedData}" />
                                    </StackPanel>
                                </Expander>

                                <!-- Runtime -->
                                <Expander IsExpanded="True">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LucideIcon Icon="Lightbulb" />
                                            <TextBlock Text="Probe Volume" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="6" Margin="12,8,12,12">
                                        <CheckBox Content="Use baked lighting"
                                                  IsChecked="{Binding ProbeVolumeEnabled, Mode=TwoWay}" />
                                        <CheckBox Content="Show probes"
                                                  IsChecked="{Binding ShowProbes, Mode=TwoWay}" />
                                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto" RowSpacing="6">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Intensity"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="16" Increment="0.05"
                                                           Value="{Binding Intensity, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.00" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!-- Volume layout -->
                                <Expander IsExpanded="True">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LucideIcon Icon="Box" />
                                            <TextBlock Text="Volume" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="6" Margin="12,8,12,12">
                                        <CheckBox Content="Fit to scene"
                                                  IsChecked="{Binding AutoBounds, Mode=TwoWay}" />
                                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Padding"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="100" Increment="0.5"
                                                           Value="{Binding BoundsPadding, Mode=TwoWay}"
                                                           IsEnabled="{Binding AutoBounds}"
                                                           ShowButtonSpinner="False" FormatString="0.##" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Probe Spacing"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="field"
                                                           Minimum="0.1" Maximum="100" Increment="0.25"
                                                           Value="{Binding ProbeSpacing, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.##" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Max / Axis"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="field"
                                                           Minimum="2" Maximum="128" Increment="1"
                                                           Value="{Binding MaxProbesPerAxis, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0" />
                                        </Grid>
                                        <StackPanel Spacing="6" IsVisible="{Binding IsManualBounds}">
                                            <TextBlock Text="Min" Classes="muted" FontSize="11" />
                                            <Grid ColumnDefinitions="*,4,*,4,*">
                                                <NumericUpDown Grid.Column="0" Classes="field"
                                                               Value="{Binding BoundsMinX, Mode=TwoWay}"
                                                               ShowButtonSpinner="False" FormatString="0.#" />
                                                <NumericUpDown Grid.Column="2" Classes="field"
                                                               Value="{Binding BoundsMinY, Mode=TwoWay}"
                                                               ShowButtonSpinner="False" FormatString="0.#" />
                                                <NumericUpDown Grid.Column="4" Classes="field"
                                                               Value="{Binding BoundsMinZ, Mode=TwoWay}"
                                                               ShowButtonSpinner="False" FormatString="0.#" />
                                            </Grid>
                                            <TextBlock Text="Max" Classes="muted" FontSize="11" />
                                            <Grid ColumnDefinitions="*,4,*,4,*">
                                                <NumericUpDown Grid.Column="0" Classes="field"
                                                               Value="{Binding BoundsMaxX, Mode=TwoWay}"
                                                               ShowButtonSpinner="False" FormatString="0.#" />
                                                <NumericUpDown Grid.Column="2" Classes="field"
                                                               Value="{Binding BoundsMaxY, Mode=TwoWay}"
                                                               ShowButtonSpinner="False" FormatString="0.#" />
                                                <NumericUpDown Grid.Column="4" Classes="field"
                                                               Value="{Binding BoundsMaxZ, Mode=TwoWay}"
                                                               ShowButtonSpinner="False" FormatString="0.#" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <!-- Quality -->
                                <Expander IsExpanded="False">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LucideIcon Icon="Sparkles" />
                                            <TextBlock Text="Quality" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="6" Margin="12,8,12,12">
                                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Rays / Probe"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="0" Grid.Column="1" Classes="field"
                                                           Minimum="16" Maximum="4096" Increment="32"
                                                           Value="{Binding SamplesPerProbe, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Bounces"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="field"
                                                           Minimum="1" Maximum="8" Increment="1"
                                                           Value="{Binding Bounces, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Validity"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center"
                                                       ToolTip.Tip="Back-face hit ratio above which a probe counts as inside geometry" />
                                            <NumericUpDown Grid.Row="2" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="1" Increment="0.05"
                                                           Value="{Binding ValidityThreshold, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.00" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>

                                <!-- Sky -->
                                <Expander IsExpanded="False">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <controls:LucideIcon Icon="Cloud" />
                                            <TextBlock Text="Sky" FontSize="11.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <StackPanel Spacing="6" Margin="12,8,12,12">
                                        <Grid ColumnDefinitions="100,*" RowDefinitions="Auto,Auto" RowSpacing="6">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Color"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <Button Grid.Row="0" Grid.Column="1" Padding="4,2"
                                                    HorizontalAlignment="Left">
                                                <Border Width="28" Height="18" CornerRadius="3"
                                                        Background="{Binding SkyColor, Converter={StaticResource ColorToBrush}}"
                                                        BorderBrush="{StaticResource AnvilBorderBrush}"
                                                        BorderThickness="1" />
                                                <Button.Flyout>
                                                    <!-- Same as the material colour: reach the live VM through the Window -->
                                                    <Flyout>
                                                        <ColorPicker Color="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).Lighting.SkyColor, Mode=TwoWay}" />
                                                    </Flyout>
                                                </Button.Flyout>
                                            </Button>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Intensity"
                                                       Classes="muted" FontSize="11" VerticalAlignment="Center" />
                                            <NumericUpDown Grid.Row="1" Grid.Column="1" Classes="field"
                                                           Minimum="0" Maximum="16" Increment="0.05"
                                                           Value="{Binding SkyIntensity, Mode=TwoWay}"
                                                           ShowButtonSpinner="False" FormatString="0.00" />
                                        </Grid>
                                        <TextBlock Text="Radiance of rays that escape the scene. Rebake to apply."
                                                   FontSize="10.5" TextWrapping="Wrap" Classes="subtle" />
                                    </StackPanel>
                                </Expander>

                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================== BOTTOM PANELS ============================== -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*"
              Background="{StaticResource AnvilPanelBackgroundBrush}">
            <Grid.Styles>
                <Style Selector="Border.bottomPanel">
                    <Setter Property="BorderBrush" Value="{StaticResource AnvilBorderBrush}" />
                </Style>
            </Grid.Styles>

            <!-- Console -->
            <Border Grid.Column="0" Classes="bottomPanel" BorderThickness="0,1,1,0">
                <Grid RowDefinitions="33,*,29">

                    <Border Grid.Row="0" Classes="panelHeader">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        Spacing="6" VerticalAlignment="Center">
                                <controls:LucideIcon Icon="Terminal" />
                                <TextBlock Text="Console" Classes="panelTitle" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                <Button Classes="pill" Content="All"
                                        Classes.active="{Binding ConsoleFilter, Converter={StaticResource EnumEquals}, ConverterParameter=All}"
                                        Command="{Binding SetConsoleFilterCommand}" CommandParameter="All" />
                                <Button Classes="pill"
                                        Classes.active="{Binding ConsoleFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Log}"
                                        Command="{Binding SetConsoleFilterCommand}" CommandParameter="Log">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <controls:LucideIcon Icon="Info" Width="11" Height="11"
                                              Foreground="{StaticResource AnvilLogBrush}" />
                                        <TextBlock Text="{Binding ConsoleLogCount}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="pill"
                                        Classes.active="{Binding ConsoleFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Warn}"
                                        Command="{Binding SetConsoleFilterCommand}" CommandParameter="Warn">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <controls:LucideIcon Icon="TriangleAlert" Width="11" Height="11"
                                              Foreground="{StaticResource AnvilWarnBrush}" />
                                        <TextBlock Text="{Binding ConsoleWarnCount}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                                <Button Classes="pill"
                                        Classes.active="{Binding ConsoleFilter, Converter={StaticResource EnumEquals}, ConverterParameter=Error}"
                                        Command="{Binding SetConsoleFilterCommand}" CommandParameter="Error">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <controls:LucideIcon Icon="CircleX" Width="11" Height="11"
                                              Foreground="{StaticResource AnvilErrorBrush}" />
                                        <TextBlock Text="{Binding ConsoleErrorCount}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="3"
                                    Background="{StaticResource AnvilInputBackgroundBrush}"
                                    BorderBrush="{StaticResource AnvilBorderBrush}"
                                    BorderThickness="1" CornerRadius="3"
                                    Padding="6,2" Margin="0,0,4,0" Width="160">
                                <Grid ColumnDefinitions="Auto,*">
                                    <controls:LucideIcon Grid.Column="0" Icon="Search"
                                          Width="11" Height="11"
                                          Foreground="{StaticResource AnvilTextSubtleBrush}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding ConsoleSearch, Mode=TwoWay}"
                                             PlaceholderText="Filter logs..."
                                             Background="Transparent" BorderThickness="0"
                                             MinHeight="18" Padding="0" FontSize="11" />
                                </Grid>
                            </Border>

                            <Button Grid.Column="3" Classes="iconButton" HorizontalAlignment="Right"
                                    ToolTip.Tip="Clear console"
                                    Command="{Binding ClearConsoleCommand}">
                                <controls:LucideIcon Icon="Trash2" />
                            </Button>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1" Classes="console"
                             ItemsSource="{Binding FilteredConsole}"
                             SelectedValueBinding="{Binding Id}"
                             SelectedValue="{Binding SelectedLogId, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="m:ConsoleEntry">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="10,4">
                                    <Grid Grid.Column="0" Width="14" Height="14"
                                          VerticalAlignment="Center" Margin="0,0,8,0">
                                        <controls:LucideIcon Icon="Info"
                                              Foreground="{StaticResource AnvilLogBrush}"
                                              IsVisible="{Binding Level, Converter={StaticResource EnumEquals}, ConverterParameter=Log}" />
                                        <controls:LucideIcon Icon="TriangleAlert"
                                              Foreground="{StaticResource AnvilWarnBrush}"
                                              IsVisible="{Binding Level, Converter={StaticResource EnumEquals}, ConverterParameter=Warn}" />
                                        <controls:LucideIcon Icon="CircleX"
                                              Foreground="{StaticResource AnvilErrorBrush}"
                                              IsVisible="{Binding Level, Converter={StaticResource EnumEquals}, ConverterParameter=Error}" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{Binding Message}"
                                               FontSize="11.5" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Source}"
                                               FontSize="10.5"
                                               Foreground="{StaticResource AnvilTextSubtleBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2"
                            Background="{StaticResource AnvilSubtleBandBrush}"
                            BorderBrush="{StaticResource AnvilBorderBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="10,4">
                        <TextBlock FontSize="10" Foreground="{StaticResource AnvilTextSubtleBrush}"
                                   VerticalAlignment="Center">
                            <Run Text="Filter:" /><Run Text=" " /><Run Text="{Binding ConsoleFilter}" />
                            <Run Text="  •  " />
                            <Run Text="{Binding ConsoleLogCount}" /><Run Text=" log" />
                            <Run Text="  •  " />
                            <Run Text="{Binding ConsoleWarnCount}" /><Run Text=" warn" />
                            <Run Text="  •  " />
                            <Run Text="{Binding ConsoleErrorCount}" /><Run Text=" error" />
                        </TextBlock>
                    </Border>
                </Grid>
            </Border>

            <!-- Assets -->
            <Border Grid.Column="1" Classes="bottomPanel" BorderThickness="0,1,0,0"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragOver="AssetsPanel_DragOver"
                    DragDrop.Drop="AssetsPanel_Drop">
                <Grid RowDefinitions="33,*">

                    <Border Grid.Row="0" Classes="panelHeader">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                        Spacing="6" VerticalAlignment="Center">
                                <controls:LucideIcon Icon="Folder"
                                      Foreground="{StaticResource AnvilFolderBrush}" />
                                <TextBlock Text="Assets" Classes="panelTitle" />
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Background="{StaticResource AnvilInputBackgroundBrush}"
                                    BorderBrush="{StaticResource AnvilBorderBrush}"
                                    BorderThickness="1" CornerRadius="3"
                                    Padding="6,2" Margin="0,0,4,0" Width="180">
                                <Grid ColumnDefinitions="Auto,*">
                                    <controls:LucideIcon Grid.Column="0" Icon="Search"
                                          Width="11" Height="11"
                                          Foreground="{StaticResource AnvilTextSubtleBrush}"
                                          VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding AssetsSearch, Mode=TwoWay}"
                                             PlaceholderText="Search assets..."
                                             Background="Transparent" BorderThickness="0"
                                             MinHeight="18" Padding="0" FontSize="11" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <!-- PointerPressed (drag-start) and DoubleTapped (add to scene) are
                             registered in code-behind with handledEventsToo so they fire even
                             though TreeViewItem marks those events handled. -->
                        <TreeView Name="AssetsTreeView"
                                  ItemsSource="{Binding AssetTree}"
                                  ToolTip.Tip="Double-click a mesh to add it to the scene (or drag it into the Hierarchy). Double-click a shader, XML or CSS file to open it in a text editor.">

                            <!-- Two-way so folder expansion survives tree rebuilds
                                 (the tree is rebuilt whenever Engine/Content changes). -->
                            <TreeView.Styles>
                                <Style Selector="TreeViewItem" x:DataType="m:AssetNode">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                </Style>
                            </TreeView.Styles>

                            <TreeView.ItemTemplate>
                                <TreeDataTemplate DataType="m:AssetNode"
                                                  ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Height="22">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Delete" Click="AssetDelete_Click" />
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <Grid Width="14" Height="14" VerticalAlignment="Center">
                                            <controls:LucideIcon Icon="Folder"
                                                  Foreground="{StaticResource AnvilFolderBrush}"
                                                  IsVisible="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Folder}" />
                                            <controls:LucideIcon Icon="Box"
                                                  Foreground="{StaticResource AnvilMeshBrush}"
                                                  IsVisible="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Mesh}" />
                                            <controls:LucideIcon Icon="FileImage"
                                                  Foreground="{StaticResource AnvilTextureBrush}"
                                                  IsVisible="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Texture}" />
                                            <controls:LucideIcon Icon="FileCode"
                                                  Foreground="{StaticResource AnvilScriptBrush}"
                                                  IsVisible="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Script}" />
                                            <controls:LucideIcon Icon="Music"
                                                  Foreground="{StaticResource AnvilAudioBrush}"
                                                  IsVisible="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Audio}" />
                                            <controls:LucideIcon Icon="Box"
                                                  Foreground="{StaticResource AnvilPrimaryAltBrush}"
                                                  IsVisible="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Material}" />
                                            <controls:LucideIcon Icon="FileImage"
                                                  Foreground="{StaticResource AnvilPrimaryBrush}"
                                                  IsVisible="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Scene}" />
                                            <controls:LucideIcon Icon="FileCode"
                                                  Foreground="{StaticResource AnvilPrimaryAltBrush}"
                                                  IsVisible="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Shader}" />
                                            <controls:LucideIcon Icon="Type"
                                                  Foreground="{StaticResource AnvilTextSubtleBrush}"
                                                  IsVisible="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Font}" />
                                            <controls:LucideIcon Icon="FileVideo"
                                                  Foreground="{StaticResource AnvilAudioBrush}"
                                                  IsVisible="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Video}" />
                                            <controls:LucideIcon Icon="File"
                                                  Foreground="{StaticResource AnvilTextSubtleBrush}"
                                                  IsVisible="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=File}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </TreeDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
